<!doctype html>
<html lang="ja" data-toybaco-theme="system">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <meta name="referrer" content="same-origin">
    <title>2段階認証の設定 | トイバコ</title>
    <%= vite_javascript_tag 'toybaco_mfa_setup' %>
    <link rel="stylesheet" href="<%= Toybaco::BrandInjector.asset_path('toybaco-brand.css') %>">
    <style>
      body { margin: 0; background: var(--toybaco-offwhite); color: var(--toybaco-ink); font: 16px/1.7 system-ui, sans-serif; }
      main { max-width: 560px; margin: 40px auto; padding: 32px; background: var(--toybaco-card); border-radius: 16px; }
      h1 { font-size: 24px; line-height: 1.4; } label { display: block; font-weight: 600; }
      button, .primary { display: inline-block; background: var(--toybaco-button); color: var(--toybaco-on-button); padding: 12px 20px; border: 0; border-radius: 8px; text-decoration: none; font: inherit; cursor: pointer; }
      input { display: block; padding: 10px; border: 1px solid var(--toybaco-control-border); background: var(--toybaco-card); color: inherit; border-radius: 6px; margin: 8px 0 16px; font-size: 22px; max-width: 100%; box-sizing: border-box; }
      code { overflow-wrap: anywhere; } .error { color: var(--toybaco-danger); } .secondary { background: transparent; color: var(--toybaco-heading); text-decoration: underline; padding-left: 0; }
      canvas { display: block; max-width: 100%; } ul { columns: 2; font-family: monospace; } @media(max-width: 600px) { main { margin: 16px; padding: 24px; } }
    </style>
  </head>
  <body><main><%= yield %></main></body>
</html>
