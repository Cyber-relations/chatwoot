<!DOCTYPE html>
<html lang="ja" data-toybaco-theme="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="referrer" content="same-origin">
  <title>無料ではじめる | トイバコ</title>
  <link rel="stylesheet" href="<%= Toybaco::BrandInjector.asset_path('toybaco-brand.css') %>">
  <link rel="stylesheet" href="<%= Toybaco::BrandInjector.asset_path('brand-assets/toybaco-free-signup.css') %>">
  <% if @captcha_site_key.present? %>
    <script src="https://js.hcaptcha.com/1/api.js?hl=ja" async defer></script>
  <% end %>
</head>
<body>
  <main>
    <a class="brand" href="https://toybaco.jp/"><picture><source srcset="/brand-assets/toybaco-logo-c4-dark.png" media="(prefers-color-scheme: dark)"><img src="/brand-assets/toybaco-logo-c4.png" alt="トイバコ" width="168"></picture></a>
    <p class="eyebrow">お問い合わせも、SNS投稿も、ひとつの管理画面に。</p>
    <h1>無料ではじめる</h1>
    <p class="lead">カード登録不要。店舗を作ったら、使うサービスをつなぎましょう。</p>
    <% if @error %><p class="error" role="alert"><%= @error %></p><% end %>
    <form action="/toybaco/free/signup" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <label for="store">店舗名</label>
      <input id="store" name="account_name" autocomplete="organization" maxlength="100" value="<%= params[:account_name].to_s.first(100) %>" required>
      <label for="name">お名前</label>
      <input id="name" name="user_full_name" autocomplete="name" maxlength="100" value="<%= params[:user_full_name].to_s.first(100) %>" required>
      <label for="email">メールアドレス</label>
      <input id="email" name="email" type="email" autocomplete="email" maxlength="254" value="<%= params[:email].to_s.first(254) %>" required>
      <label for="password">パスワード</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" aria-describedby="password-help" required>
      <p id="password-help" class="hint">8文字以上。英大文字・小文字・数字・記号を含めてください。</p>
      <label class="terms"><input type="checkbox" name="accept_terms" value="1" required <%= 'checked' if params[:accept_terms] == '1' %>><span><a href="https://toybaco.jp/terms/" target="_blank" rel="noopener">利用規約</a>と<a href="https://toybaco.jp/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意する</span></label>
      <% if @captcha_site_key.present? %><div class="h-captcha" data-sitekey="<%= @captcha_site_key %>"></div><% end %>
      <button type="submit">確認メールを送る</button>
    </form>
    <% if @captcha_site_key.present? %>
    <%# 部品の準備 = hCaptcha の API があり、ウィジェットの iframe が現れていること。
        token の無い送信は止める。準備ができていなければ読み込み失敗の案内のまま止め、準備済みのときだけチェックを促す。
        読み込み失敗の案内は 6 秒たっても準備できないときに出し、最大 30 秒まで 500ms ごとに準備を確かめて、準備できたら消す。 %>
    <script>
      (function () {
        var form = document.querySelector('form[action="/toybaco/free/signup"]');
        var widget = document.querySelector('.h-captcha');
        if (!form || !widget) return;
        var CHECK = '「私は人間です」の確認にチェックを入れてから送信してください。';
        var FAILED = '確認部品を読み込めませんでした。ページを再読み込みしてください。';
        var notice = document.createElement('p');
        notice.className = 'error';
        notice.setAttribute('role', 'alert');
        notice.hidden = true;
        notice.textContent = CHECK;
        widget.insertAdjacentElement('afterend', notice);
        function show(message) {
          notice.hidden = false;
          notice.textContent = message;
        }
        function api() {
          return window.hcaptcha && typeof window.hcaptcha.getResponse === 'function' ? window.hcaptcha : null;
        }
        function ready() {
          return Boolean(api() && widget.querySelector('iframe'));
        }
        form.addEventListener('submit', function (event) {
          var token = '';
          var failed = !api();
          if (!failed) {
            try {
              token = api().getResponse();
            } catch (error) {
              failed = true;
            }
          }
          if (token) {
            notice.hidden = true;
            return;
          }
          event.preventDefault();
          show(failed || !widget.querySelector('iframe') ? FAILED : CHECK);
          widget.scrollIntoView({ block: 'center' });
        });
        var started = Date.now();
        var poll = window.setInterval(function () {
          if (ready()) {
            window.clearInterval(poll);
            if (notice.textContent === FAILED) notice.hidden = true;
            return;
          }
          var elapsed = Date.now() - started;
          if (elapsed >= 6000 && (notice.hidden || notice.textContent !== FAILED)) show(FAILED);
          if (elapsed >= 30000) window.clearInterval(poll);
        }, 500);
      })();
    </script>
    <% end %>
    <p class="login">登録済みの方は <a href="/app/login">ログイン</a></p>
  </main>
</body>
</html>
