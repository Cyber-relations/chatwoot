<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ご契約内容 | トイバコ</title>
<style>
:root{--navy:#1F3A5F;--navy-deep:#163049;--coral:#FF6B5B;--focus:#C84435;--control-border:#82878F;--surface:#FCFBF8;--paper:#FFFDF9;--ink:#24303F;--muted:#596675;--line:#E5E3DB;--green:#0B7A35}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Hiragino Sans","Noto Sans JP",sans-serif;background:var(--surface);color:var(--ink);line-height:1.6;font-size:13px;padding:24px 20px}
.wrap{max-width:640px;margin:0 auto}
h1{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:4px}
.lead{color:var(--muted);font-size:12px;margin-bottom:16px}
.card{background:var(--paper);border:1.5px solid var(--line);border-radius:12px;padding:16px;margin-bottom:12px}
.renewal-notice{border-left:4px solid var(--coral)}
.renewal-notice .btn{margin-top:12px;text-decoration:none}
.plan-name{font-size:15px;font-weight:600;color:var(--navy)}
.plan-price{margin:6px 0 2px;font-size:22px;font-weight:600;color:var(--navy)}
.plan-price span{font-size:12px;color:var(--muted);font-weight:400}
.plan-total{font-size:12px;color:var(--muted)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:6px 0;border-top:1px solid var(--line);font-size:13px}
.row:first-of-type{border-top:none}
.badge{font-size:12px;font-weight:600;border-radius:999px;padding:2px 8px}
.badge.on{background:#E8F5EC;color:var(--green)}
.badge.off{background:#F0EFEA;color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:32px;border:none;cursor:pointer;font-family:inherit;font-size:13px;line-height:18px;font-weight:600;border-radius:9px;padding:5px 14px;transition:opacity .15s}
.btn:hover{opacity:.88}
.btn-navy{background:var(--navy);color:#fff}
.btn-back{background:transparent;color:var(--navy-deep);border:1.5px solid var(--line)}
.note{font-size:12px;color:var(--muted);margin-top:8px}
.note a{color:var(--navy)}
.err{display:none;color:#C0392B;font-size:12px;margin-top:8px}
.lp-line{color:var(--navy-deep);font-size:13px;margin-bottom:12px}
.dlg-back{position:fixed;inset:0;background:rgba(22,48,73,.42);display:flex;align-items:center;justify-content:center;padding:24px;z-index:20}
.dlg-back[hidden]{display:none}
.dlg{background:var(--surface);border:1.5px solid var(--line);border-radius:12px;padding:16px;max-width:420px;width:100%}
.dlg-title{font-size:15px;font-weight:600;color:var(--navy);margin-bottom:8px}
.dlg-body{color:var(--navy-deep);font-size:13px;margin-bottom:14px}
.dlg-actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
.btn:disabled{opacity:.55;cursor:wait}
.btn:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
.change-title{font-size:15px;font-weight:600;color:var(--navy)}
.change-controls{display:grid;gap:10px;margin-top:12px}
.change-controls label{font-size:12px;font-weight:500}
.change-controls select{width:100%;min-height:32px;font:inherit;line-height:18px;color:var(--ink);background:var(--paper);border:1.5px solid var(--control-border);border-radius:9px;padding:5px 10px}
.change-controls .btn{justify-self:start}
.change-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.change-error{color:#C0392B;font-size:12px;margin-top:8px}
.change-detail{white-space:pre-line;font-size:13px;margin:12px 0;color:var(--navy-deep)}
#plan-change-dialog .dlg{max-height:calc(100dvh - 48px);overflow:auto}
[hidden]{display:none!important}
@media(max-width:767px){.btn,.change-controls select{min-height:40px;padding-block:9px}}
@media(max-width:520px){body{padding:16px 12px}.dlg-back{padding:16px}.change-actions .btn{width:100%;text-align:center}}
</style>
</head>
<body>
<div class="wrap" id="billing-content">
  <% growth = @contract && @contract.dig('entitlements', 'ai_meter') == Toybaco::GrowthTerms::METER %>
  <% growth_free = growth && @contract['plan_id'] == 'free' %>
  <h1>ご契約内容</h1>
  <p class="lead"><%= @account.name %></p>
  <% if @renewal_notice %>
    <section class="card renewal-notice" aria-labelledby="renewal-heading" role="status">
      <h2 class="change-title" id="renewal-heading">更新のお支払いをご確認ください</h2>
      <% if @renewal_notice[:expired] %>
        <p class="note">支払いの確認期限を過ぎました。</p>
      <% else %>
        <p class="note">確認期限：<time datetime="<%= @renewal_notice[:deadline] %>"><%= Time.iso8601(@renewal_notice[:deadline]).in_time_zone('Tokyo').strftime('%Y年%-m月%-d日 %-H:%M') %>（日本時間）</time></p>
      <% end %>
      <% if @contract.dig('entitlements', 'features', 'ai_auto_reply') %>
        <p class="note"><%= @renewal_notice[:expired] ? '自動応答を一時停止しています。' : '期限を過ぎると自動応答が停止します。' %></p>
      <% end %>
      <% if @portal_ready %><a class="btn btn-navy" href="#portal">支払い方法を確認</a><% end %>
    </section>
  <% end %>
  <% if growth && @admin && !@contract.dig('entitlements', 'features', 'ai_auto_reply') %>
    <div class="card"><h2 class="change-title">自動応答を体験する</h2><p class="note">オーナーが開始してから14日間または100回の早い方までです。対象は、トイバコで接続した Gmail または Microsoft のメール受信箱だけです。カード登録は不要です。メールの接続は提供元の審査完了後に開放します。</p><p class="note"><a class="btn btn-back" href="/toybaco/growth/trial?account_id=<%= @account.id %>" target="_top">回答例と体験状況を確認</a></p></div>
  <% end %>

  <div class="card">
    <% if @plan %>
      <div class="plan-name"><% if growth_free %>無料プラン<% else %><%= @plan[:name] %> プラン<% end %></div>
      <% if growth_free %>
        <div class="plan-price">¥0<span> / 月</span></div>
        <p class="note">スタッフの追加料金はかかりません。</p>
        <% if @admin %><p class="note"><a class="btn btn-navy" href="/toybaco/growth/purchase?account_id=<%= @account.id %>" target="_top">有料プランを見る</a></p><% end %>
      <% elsif @store_purchase %>
        <p class="note">購入元の追加店舗オプションで開通した店舗です。</p>
        <p class="note">保存した契約版: <%= @contract.fetch('plan_version') %> / <%= @contract['cycle'] == 'year' ? '年払い' : '月払い' %></p>
      <% elsif @billing %>
        <p class="note"><%= @billing[:status_label] %><%= @billing[:cancel_at_period_end] ? '・現在の契約期間末で解約予定' : '' %></p>
        <% @billing[:items].each do |item| %>
          <div class="row"><span><%= item[:name] %> × <%= item[:quantity] %></span></div>
          <div class="plan-price">¥<%= number_with_delimiter(item[:amount]) %><span> /<%= item[:cycle_label] %>（<%= item[:tax_label] %>）</span></div>
        <% end %>
        <p class="note">上記は契約した料金です。割引・税・日割り調整を含む実際のお支払いは請求内容をご確認ください。</p>
        <% if (invoice = @billing[:invoice]) %>
          <div class="row"><span>直近の請求額（税込）</span><strong>¥<%= number_with_delimiter(invoice[:total]) %></strong></div>
          <div class="row"><span>お支払い済みの金額</span><span>¥<%= number_with_delimiter(invoice[:amount_paid]) %></span></div>
          <% unless invoice[:discount].nil? %><div class="row"><span>割引額</span><span>¥<%= number_with_delimiter(invoice[:discount]) %></span></div><% end %>
          <% unless invoice[:tax].nil? %><div class="row"><span>税額</span><span>¥<%= number_with_delimiter(invoice[:tax]) %></span></div><% end %>
          <% if invoice[:url] %><p class="note"><a href="<%= invoice[:url] %>" target="_blank" rel="noopener">直近の請求内容を確認する</a></p><% end %>
        <% end %>
      <% elsif @subscription_id %>
        <p class="note" role="status">現在の請求情報を取得できません。時間をおいて再度お試しください。お支払い方法・請求履歴からも確認できます。</p>
      <% else %>
        <p class="note">料金とお支払い条件は、ご契約時の案内をご確認ください。</p>
      <% end %>
    <% else %>
      <div class="plan-name">ご契約プランの情報が見つかりません</div>
      <p class="note">開通処理の途中か、個別契約の可能性があります。<a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へお問い合わせください。</p>
    <% end %>
  </div>

  <div class="card">
    <div class="row">
      <span>SNS 予約投稿</span>
      <% if @posting %>
        <span class="badge on">利用中</span>
      <% else %>
        <span class="badge off">未契約</span>
      <% end %>
    </div>
    <div class="row">
      <span><%= growth ? 'AIアシスタント（返信・投稿で共通）' : 'AI 自動応答' %></span>
      <% ai_reply = @contract && @contract.dig('entitlements', 'features', 'ai_reply') %>
      <% ai_limits = @contract && @contract.dig('entitlements', 'limits') %>
      <% ai_limit = ai_limits && ai_limits['ai_replies'] %>
      <% if growth %>
        <span class="badge on">月<%= number_with_delimiter(ai_limits.fetch('ai_generations')) %>回</span>
      <% elsif ai_reply == false %>
        <span class="badge off">対象外</span>
      <% elsif ai_reply == true && ai_limit.is_a?(Integer) && ai_limit >= 0 %>
        <span class="badge on">契約に含まれる（月<%= number_with_delimiter(ai_limit) %>件）</span>
      <% elsif ai_reply == true && ai_limits&.key?('ai_replies') && ai_limit.nil? %>
        <span class="badge on">契約に含まれる（月上限なし）</span>
      <% else %>
        <span class="badge off">確認できません</span>
      <% end %>
    </div>
    <% if growth %>
      <% automatic_reply = @contract.dig('entitlements', 'features', 'ai_auto_reply') %>
      <% payment_stop = automatic_reply && @renewal_notice && @renewal_notice[:expired] %>
      <div class="row"><span>AI 自動応答</span><span class="badge <%= automatic_reply && !payment_stop ? 'on' : 'off' %>"><%= payment_stop ? '支払い確認まで停止' : (automatic_reply ? '利用可能（設定後に開始）' : '審査完了後に体験できます（上位プランでも利用できます）') %></span></div>
      <% if @admin && (Toybaco::Growth::PackCatalog.available? || Toybaco::GrowthPackOrder.exists?(account_id: @account.id)) %>
        <p class="note"><a class="btn btn-back" href="/toybaco/growth/packs?account_id=<%= @account.id %>" target="_top">AI追加パック・残り回数を確認</a></p>
      <% end %>
    <% end %>
    <p class="note">AI の表示はご契約上の利用枠です。応答の設定・稼働状況は受信箱でご確認ください。</p>
    <% unless growth %>
    <p class="note">オプションの追加・変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へどうぞ(<a href="https://toybaco.jp/contact/" target="_blank" rel="noopener">お問い合わせフォーム</a>でも受け付けています)。担当者が確認してご連絡します(平日10〜18時)。</p>
    <% end %>
  </div>

  <% if @admin && @plan_changes %>
  <section class="card" id="plan-change-panel" aria-labelledby="plan-change-heading">
    <h2 class="change-title" id="plan-change-heading">プランを変更する</h2>
    <p class="note" id="plan-change-status" role="status" aria-live="polite" tabindex="-1">契約の変更内容を確認しています。</p>
    <form class="change-controls" id="plan-change-form" hidden>
      <label for="plan-change-select">変更先のプラン・お支払い周期</label>
      <select id="plan-change-select" required aria-describedby="plan-change-policy"></select>
      <p class="note" id="plan-change-policy"></p>
      <button type="submit" class="btn btn-navy" id="plan-change-preview">変更内容を確認する</button>
    </form>
    <p class="change-error" id="plan-change-error" role="alert" hidden></p>
    <div class="change-actions">
      <a class="btn btn-navy" id="plan-change-payment" target="_blank" rel="noopener" hidden>変更のお支払いを確認する</a>
      <button type="button" class="btn btn-back" id="plan-change-refresh" hidden>前回のお申し込みを確認する</button>
      <button type="button" class="btn btn-back" id="plan-change-cancel-reservation" hidden>変更予約を取り消す</button>
      <button type="button" class="btn btn-back" id="plan-change-reload" hidden>契約内容を更新する</button>
    </div>
    <p class="note" id="plan-change-support" hidden>個別の契約条件やオプションを含む変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へお問い合わせください。</p>
    <noscript><p class="note">プラン変更にはJavaScriptを有効にしてください。サポートでも受け付けています。</p></noscript>
    <script id="plan-change-state" type="application/json"><%= raw(json_escape(@plan_changes.to_json)) %></script>
  </section>
  <% end %>

  <% if @storage %>
    <% storage_format = Toybaco::Growth::StorageUsage %>
    <% storage_limit = storage_format.decimal(@storage['limit_bytes'], storage_format::GB) %>
    <section class="card" aria-labelledby="storage-heading">
      <h2 class="change-title" id="storage-heading">保存容量と保存期間</h2>
      <% if @storage['reason'] == 'unavailable' %>
        <div class="row"><span>保存容量</span><span>上限 <%= storage_limit %> GB</span></div>
        <p class="note" role="status">使用量を取得できません。時間をおいて再度お試しください。</p>
      <% else %>
        <div class="row"><span>保存容量</span><span>使用中 <%= storage_format.used_gigabytes(@storage['used_bytes']) %> GB / 上限 <%= storage_limit %> GB</span></div>
        <% if @storage['level'] == 'warn80' %>
          <p class="note"><span class="badge off">上限の 80% に達しています</span> <%= @contract['plan_id'] == 'pro' ? '不要な添付の削除で容量を確保できます。' : '不要な添付の削除や上位プランで容量を確保できます。' %></p>
        <% elsif @storage['level'] == 'full' %>
          <p class="note"><span class="badge off">上限に達しています</span> 現在は追加の受け入れを止めていません。整理はサポート（<a href="mailto:support@toybaco.jp">support@toybaco.jp</a>）へご相談ください。</p>
        <% end %>
      <% end %>
      <% if @storage['history_months'] %>
        <div class="row"><span>会話・送信履歴・公開済み投稿本文</span><span>直近 <%= @storage['history_months'] %> か月保存</span></div>
      <% end %>
      <% if @storage['inbound_attachment_bytes'] && @storage['posting_file_bytes'] %>
        <div class="row"><span>1 ファイル上限</span><span>受信添付 <%= storage_format.decimal(@storage['inbound_attachment_bytes'], storage_format::MB) %>MB・投稿素材 <%= storage_format.decimal(@storage['posting_file_bytes'], storage_format::MB) %>MB</span></div>
      <% end %>
      <p class="note">使用量は会話の添付ファイル（受信・送信）の合計です。投稿素材は現在計上していません。1 ファイル上限は、接続先の上限が小さい場合はそちらが適用されます。</p>
    </section>
  <% end %>
  <% if growth && @admin && ENV['TOYBACO_GROWTH_RETENTION_ENABLED'] == 'true' %>
    <section class="card"><h2 class="change-title">接続の保留状況</h2><p class="note"><a class="btn btn-back" href="/toybaco/growth/held?account_id=<%= @account.id %>">接続と予約を確認</a></p></section>
  <% end %>
  <% if growth && !growth_free && @admin && ENV['TOYBACO_GROWTH_RETENTION_ENABLED'] == 'true' %>
    <section class="card"><h2 class="change-title">無料プランで継続する接続</h2><p class="note">解約後に残す受信箱・投稿先を選べます。</p><p class="note"><a class="btn btn-back" href="/toybaco/growth/retention?account_id=<%= @account.id %>&amp;target=free">接続を選ぶ</a></p></section>
  <% end %>

  <div class="card">
    <% if @portal_ready %>
      <button class="btn btn-navy" id="portal">お支払い方法・請求履歴</button>
      <p class="note">カード情報の確認・変更は、決済代行(Stripe)の安全なページで行います。トイバコがカード番号をお預かりすることはありません。</p>
      <p class="err" id="portal-err">ページを開けませんでした。時間をおいて再度お試しいただくか、お問い合わせフォームからお知らせください。</p>
    <% elsif growth_free %>
      <p class="note">無料プランでは請求はありません。有料化するときに決済画面でお支払い方法を設定します。</p>
    <% elsif @store_purchase %>
      <p class="note">お支払い・変更は、購入元の契約で管理します。ご不明な点は店舗の管理者へお問い合わせください。</p>
    <% elsif !@admin %>
      <p class="note">契約の変更には管理者権限が必要です。</p>
    <% else %>
      <p class="note">このご契約は請求書払い(または個別契約)です。お支払い方法やプランの変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へご連絡ください。</p>
    <% end %>
  </div>

  <% if @portal_ready && (!@billing || (!@billing[:cancel_at_period_end] && @billing[:status] != 'canceled')) %>
  <div class="card" id="cancel-box">
    <p class="lp-line">解約は、管理画面から2クリックで手続きできます。</p>
    <button type="button" class="btn btn-navy" id="cancel-open">解約する</button>
    <p class="err" id="cancel-err">解約できませんでした。時間をおいて再度お試しください。</p>
    <%# 期間末に無料プランへ移るのは新料金版の契約だけ。旧版の契約には従来の案内を出す。 %>
    <p class="note" id="cancel-done-message" hidden><%= growth ? '解約を受け付けました。現在の契約期間末に無料プランへ移ります。' : 'お申し出以降、次回分の請求は発生しません。日割りの返金はありません。' %></p>
  </div>
  <div class="dlg-back" id="cancel-dialog" hidden>
    <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="cancel-title">
      <p class="dlg-title" id="cancel-title">この契約を解約しますか？</p>
      <p class="dlg-body" id="cancel-reservation-note" hidden>変更予約を取り消し、現在の契約期間末で解約します。</p>
      <% if growth %>
      <p class="dlg-body">解約すると次回の更新を停止します。現在の契約期間末までは現在のプランを使えます。現在の契約期間末に無料プランへ移り、会話・原稿・スタッフはそのまま残ります。無料プランの上限を超える接続は停止し、予約投稿は保留します（削除はしません）。期間途中の日割り返金はありません。</p>
      <% else %>
      <p class="dlg-body">お申し出以降、次回分の請求は発生しません。日割りの返金はありません。</p>
      <% end %>
      <div class="dlg-actions">
        <button type="button" class="btn btn-back" id="cancel-back">戻る</button>
        <button type="button" class="btn btn-navy" id="cancel-confirm">解約する</button>
      </div>
    </div>
  </div>
  <% end %>
</div>

<% if @admin && @plan_changes %>
<div class="dlg-back" id="plan-change-dialog" hidden>
  <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="plan-change-dialog-title" aria-describedby="plan-change-detail">
    <h2 class="dlg-title" id="plan-change-dialog-title"></h2>
    <p class="change-detail" id="plan-change-detail"></p>
    <div class="dlg-actions">
      <button type="button" class="btn btn-back" id="plan-change-back">戻る</button>
      <button type="button" class="btn btn-navy" id="plan-change-confirm"></button>
    </div>
  </div>
</div>
<script src="/brand-assets/toybaco-plan-change.js" defer></script>
<% end %>

<script>
(function () {
  var btn = document.getElementById('portal');
  if (!btn) return;
  btn.addEventListener('click', function () {
    btn.disabled = true;
    fetch(window.location.pathname + '/portal' + window.location.search, {
      method: 'POST', credentials: 'same-origin'
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (d) {
        if (d && typeof d.url === 'string' && d.url.indexOf('https://billing.stripe.com/') === 0) {
          window.open(d.url, '_blank', 'noopener');
        } else { throw new Error('bad url'); }
      })
      .catch(function () { document.getElementById('portal-err').style.display = 'block'; })
      .finally(function () { btn.disabled = false; });
  });
})();
(function () {
  var openBtn = document.getElementById('cancel-open');
  var dialog = document.getElementById('cancel-dialog');
  var backBtn = document.getElementById('cancel-back');
  var confirmBtn = document.getElementById('cancel-confirm');
  var err = document.getElementById('cancel-err');
  var reservationNote = document.getElementById('cancel-reservation-note');
  var doneMessage = document.getElementById('cancel-done-message');
  var reservationToken = null;
  if (!openBtn || !dialog || !backBtn || !confirmBtn || !doneMessage) return;
  function currentReservationToken() {
    try {
      var stateElement = document.getElementById('plan-change-state');
      var state = stateElement && JSON.parse(stateElement.textContent);
      return state && typeof state.cancellation_token === 'string' && state.cancellation_token ? state.cancellation_token : null;
    } catch (_) { return null; }
  }
  function hideDialog() { dialog.hidden = true; reservationToken = null; }
  openBtn.addEventListener('click', function () {
    if (err) err.style.display = 'none';
    reservationToken = currentReservationToken();
    if (reservationNote) reservationNote.hidden = !reservationToken;
    dialog.hidden = false;
  });
  backBtn.addEventListener('click', hideDialog);
  confirmBtn.addEventListener('click', function () {
    if (confirmBtn.disabled || dialog.hidden) return;
    confirmBtn.disabled = true;
    var options = { method: 'POST', credentials: 'same-origin' };
    if (reservationToken) {
      options.headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
      options.body = JSON.stringify({ reservation_token: reservationToken });
    }
    fetch(window.location.pathname + '/cancel' + window.location.search, options)
      .then(function (r) {
        return r.json().then(function (d) {
          if (!r.ok) {
            var failure = new Error(d && typeof d.message === 'string' ? d.message : '解約できませんでした。時間をおいて再度お試しください。');
            failure.toybacoMessage = true;
            throw failure;
          }
          return d;
        });
      })
      .then(function (d) {
        if (!d || d.cancelled !== true) throw new Error('not cancelled');
        hideDialog();
        openBtn.hidden = true;
        var planPanel = document.getElementById('plan-change-panel');
        if (planPanel) planPanel.hidden = true;
        if (!document.getElementById('cancel-done')) {
          var done = document.createElement('p');
          done.id = 'cancel-done';
          done.className = 'note';
          done.textContent = doneMessage.textContent;
          openBtn.parentNode.appendChild(done);
        }
      })
      .catch(function (error) {
        hideDialog();
        if (err) {
          err.textContent = error.toybacoMessage ? error.message : '解約できませんでした。時間をおいて再度お試しください。';
          err.style.display = 'block';
        }
        openBtn.focus();
      })
      .finally(function () { confirmBtn.disabled = false; });
  });
})();
</script>
</body>
</html>
