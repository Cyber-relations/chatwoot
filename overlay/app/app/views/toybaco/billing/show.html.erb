<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ご契約内容 | トイバコ</title>
<style>
:root{--navy:#1F3A5F;--navy-deep:#163049;--coral:#FF6B5B;--surface:#FCFBF8;--paper:#FFFDF9;--ink:#24303F;--muted:#6B7684;--line:#E5E3DB;--green:#2FA35C}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"Hiragino Sans","Noto Sans JP",sans-serif;background:var(--surface);color:var(--ink);line-height:1.8;font-size:15px;padding:32px 24px}
.wrap{max-width:640px;margin:0 auto}
h1{font-size:1.3rem;color:var(--navy);margin-bottom:4px}
.lead{color:var(--muted);font-size:.85rem;margin-bottom:22px}
.card{background:var(--paper);border:1.5px solid var(--line);border-radius:16px;padding:22px 24px;margin-bottom:14px}
.plan-name{font-size:1.15rem;font-weight:700;color:var(--navy)}
.plan-price{margin:6px 0 2px;font-size:1.6rem;font-weight:700;color:var(--navy)}
.plan-price span{font-size:.8rem;color:var(--muted);font-weight:400}
.plan-total{font-size:.82rem;color:var(--muted)}
.row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid var(--line);font-size:.9rem}
.row:first-of-type{border-top:none}
.badge{font-size:.75rem;font-weight:700;border-radius:999px;padding:3px 12px}
.badge.on{background:#E8F5EC;color:var(--green)}
.badge.off{background:#F0EFEA;color:var(--muted)}
.btn{display:inline-block;border:none;cursor:pointer;font-family:inherit;font-size:.92rem;font-weight:700;border-radius:999px;padding:12px 26px;transition:opacity .15s}
.btn:hover{opacity:.88}
.btn-navy{background:var(--navy);color:#fff}
.btn-back{background:transparent;color:var(--navy-deep);border:1.5px solid var(--line)}
.note{font-size:.78rem;color:var(--muted);margin-top:10px}
.note a{color:var(--navy)}
.err{display:none;color:#C0392B;font-size:.82rem;margin-top:8px}
.lp-line{color:var(--navy-deep);font-size:.9rem;margin-bottom:16px}
.dlg-back{position:fixed;inset:0;background:rgba(22,48,73,.42);display:flex;align-items:center;justify-content:center;padding:24px;z-index:20}
.dlg-back[hidden]{display:none}
.dlg{background:var(--surface);border:1.5px solid var(--line);border-radius:16px;padding:22px 24px;max-width:420px;width:100%}
.dlg-title{font-size:1.05rem;font-weight:700;color:var(--navy);margin-bottom:8px}
.dlg-body{color:var(--navy-deep);font-size:.9rem;margin-bottom:18px}
.dlg-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.btn:disabled{opacity:.55;cursor:wait}
.btn:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid var(--coral);outline-offset:3px}
.change-title{font-size:1.05rem;color:var(--navy)}
.change-controls{display:grid;gap:12px;margin-top:14px}
.change-controls label{font-size:.85rem;font-weight:700}
.change-controls select{width:100%;font:inherit;color:var(--ink);background:var(--paper);border:1.5px solid var(--line);border-radius:10px;padding:10px}
.change-controls .btn{justify-self:start}
.change-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.change-error{color:#C0392B;font-size:.85rem;margin-top:10px}
.change-detail{white-space:pre-line;font-size:.9rem;margin:14px 0;color:var(--navy-deep)}
#plan-change-dialog .dlg{max-height:calc(100dvh - 48px);overflow:auto}
[hidden]{display:none!important}
@media(max-width:520px){body{padding:22px 14px}.card{padding:18px}.dlg-back{padding:16px}.dlg{padding:20px}.change-actions .btn{width:100%;text-align:center}}
</style>
</head>
<body>
<div class="wrap" id="billing-content">
  <h1>ご契約内容</h1>
  <p class="lead"><%= @account.name %></p>

  <div class="card">
    <% if @plan %>
      <div class="plan-name"><%= @plan[:name] %> プラン</div>
      <% if @billing %>
        <p class="note"><%= @billing[:status_label] %><%= @billing[:cancel_at_period_end] ? '・現在の契約期間末で解約予定' : '' %></p>
        <% @billing[:items].each do |item| %>
          <div class="row"><span><%= item[:name] %> × <%= item[:quantity] %></span></div>
          <div class="plan-price">¥<%= number_with_delimiter(item[:amount]) %><span> /<%= item[:cycle_label] %>（<%= item[:tax_label] %>）</span></div>
        <% end %>
        <p class="note">上記は契約した料金です。割引・税・日割り調整を含む実際のお支払いは請求内容をご確認ください。</p>
        <% if (invoice = @billing[:invoice]) %>
          <div class="row"><span>直近の請求額（税込）</span><strong>¥<%= number_with_delimiter(invoice[:total]) %></strong></div>
          <div class="row"><span>お支払い済みの金額</span><span>¥<%= number_with_delimiter(invoice[:amount_paid]) %></span></div>
          <% unless invoice[:discount].nil? %><div class="row"><span>割引額</span><span>¥<%= number_with_delimiter(invoice[:discount]) %></span></div><% end %>
          <% unless invoice[:tax].nil? %><div class="row"><span>税額</span><span>¥<%= number_with_delimiter(invoice[:tax]) %></span></div><% end %>
          <% if invoice[:url] %><p class="note"><a href="<%= invoice[:url] %>" target="_blank" rel="noopener">直近の請求内容を確認する</a></p><% end %>
        <% end %>
      <% elsif !@admin %>
        <p class="note">請求情報は管理者の方が確認できます。</p>
      <% elsif @subscription_id %>
        <p class="note" role="status">現在の請求情報を取得できません。時間をおいて再度お試しください。お支払い方法・請求履歴からも確認できます。</p>
      <% else %>
        <p class="note">料金とお支払い条件は、ご契約時の案内をご確認ください。</p>
      <% end %>
    <% else %>
      <div class="plan-name">ご契約プランの情報が見つかりません</div>
      <p class="note">開通処理の途中か、個別契約の可能性があります。<a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へお問い合わせください。</p>
    <% end %>
  </div>

  <div class="card">
    <div class="row">
      <span>SNS 予約投稿</span>
      <% if @posting %>
        <span class="badge on">利用中</span>
      <% else %>
        <span class="badge off">未契約</span>
      <% end %>
    </div>
    <div class="row">
      <span>AI 自動応答</span>
      <% ai_reply = @contract && @contract.dig('entitlements', 'features', 'ai_reply') %>
      <% ai_limits = @contract && @contract.dig('entitlements', 'limits') %>
      <% ai_limit = ai_limits && ai_limits['ai_replies'] %>
      <% if ai_reply == false %>
        <span class="badge off">対象外</span>
      <% elsif ai_reply == true && ai_limit.is_a?(Integer) && ai_limit >= 0 %>
        <span class="badge on">契約に含まれる（月<%= number_with_delimiter(ai_limit) %>件）</span>
      <% elsif ai_reply == true && ai_limits&.key?('ai_replies') && ai_limit.nil? %>
        <span class="badge on">契約に含まれる（月上限なし）</span>
      <% else %>
        <span class="badge off">確認できません</span>
      <% end %>
    </div>
    <p class="note">AI の表示はご契約上の利用枠です。応答の設定・稼働状況は受信箱でご確認ください。</p>
    <p class="note">オプションの追加・変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へどうぞ(<a href="https://toybaco.jp/" target="_blank" rel="noopener">toybaco.jp</a> 右下のチャットでも受け付けています)。1営業日以内に反映します。</p>
  </div>

  <% if @admin && @plan_changes %>
  <section class="card" id="plan-change-panel" aria-labelledby="plan-change-heading">
    <h2 class="change-title" id="plan-change-heading">プランを変更する</h2>
    <p class="note" id="plan-change-status" role="status" aria-live="polite" tabindex="-1">契約の変更内容を確認しています。</p>
    <form class="change-controls" id="plan-change-form" hidden>
      <label for="plan-change-select">変更先のプラン・お支払い周期</label>
      <select id="plan-change-select" required aria-describedby="plan-change-policy"></select>
      <p class="note" id="plan-change-policy"></p>
      <button type="submit" class="btn btn-navy" id="plan-change-preview">変更内容を確認する</button>
    </form>
    <p class="change-error" id="plan-change-error" role="alert" hidden></p>
    <div class="change-actions">
      <a class="btn btn-navy" id="plan-change-payment" target="_blank" rel="noopener" hidden>変更のお支払いを確認する</a>
      <button type="button" class="btn btn-back" id="plan-change-refresh" hidden>前回のお申し込みを確認する</button>
      <button type="button" class="btn btn-back" id="plan-change-cancel-reservation" hidden>変更予約を取り消す</button>
      <button type="button" class="btn btn-back" id="plan-change-reload" hidden>契約内容を更新する</button>
    </div>
    <p class="note" id="plan-change-support" hidden>個別の契約条件やオプションを含む変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へお問い合わせください。</p>
    <noscript><p class="note">プラン変更にはJavaScriptを有効にしてください。サポートでも受け付けています。</p></noscript>
    <script id="plan-change-state" type="application/json"><%= raw(json_escape(@plan_changes.to_json)) %></script>
  </section>
  <% end %>

  <div class="card">
    <% if @portal_ready %>
      <button class="btn btn-navy" id="portal">お支払い方法・請求履歴</button>
      <p class="note">カード情報の確認・変更は、決済代行(Stripe)の安全なページで行います。トイバコがカード番号をお預かりすることはありません。</p>
      <p class="err" id="portal-err">ページを開けませんでした。時間をおいて再度お試しいただくか、チャットでお知らせください。</p>
    <% elsif !@admin %>
      <p class="note">契約情報の確認・変更は、管理者の方のみ行えます。</p>
    <% else %>
      <p class="note">このご契約は請求書払い(または個別契約)です。お支払い方法やプランの変更は <a href="mailto:support@toybaco.jp">support@toybaco.jp</a> へご連絡ください。</p>
    <% end %>
  </div>

  <% if @portal_ready && (!@billing || (!@billing[:cancel_at_period_end] && @billing[:status] != 'canceled')) %>
  <div class="card" id="cancel-box">
    <p class="lp-line">月払いは契約の縛りなし。解約はいつでも、管理画面から2クリック</p>
    <button type="button" class="btn btn-navy" id="cancel-open">解約する</button>
    <p class="err" id="cancel-err">解約できませんでした。時間をおいて再度お試しください。</p>
  </div>
  <div class="dlg-back" id="cancel-dialog" hidden>
    <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="cancel-title">
      <p class="dlg-title" id="cancel-title">この契約を解約しますか？</p>
      <p class="dlg-body" id="cancel-reservation-note" hidden>変更予約を取り消し、現在の契約期間末で解約します。</p>
      <p class="dlg-body">お申し出以降、次回分の請求は発生しません。日割りの返金はありません。</p>
      <div class="dlg-actions">
        <button type="button" class="btn btn-back" id="cancel-back">戻る</button>
        <button type="button" class="btn btn-navy" id="cancel-confirm">解約する</button>
      </div>
    </div>
  </div>
  <% end %>
</div>

<% if @admin && @plan_changes %>
<div class="dlg-back" id="plan-change-dialog" hidden>
  <div class="dlg" role="dialog" aria-modal="true" aria-labelledby="plan-change-dialog-title" aria-describedby="plan-change-detail">
    <h2 class="dlg-title" id="plan-change-dialog-title"></h2>
    <p class="change-detail" id="plan-change-detail"></p>
    <div class="dlg-actions">
      <button type="button" class="btn btn-back" id="plan-change-back">戻る</button>
      <button type="button" class="btn btn-navy" id="plan-change-confirm"></button>
    </div>
  </div>
</div>
<script src="/brand-assets/toybaco-plan-change.js" defer></script>
<% end %>

<script>
(function () {
  var btn = document.getElementById('portal');
  if (!btn) return;
  btn.addEventListener('click', function () {
    btn.disabled = true;
    fetch(window.location.pathname + '/portal' + window.location.search, {
      method: 'POST', credentials: 'same-origin'
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (d) {
        if (d && typeof d.url === 'string' && d.url.indexOf('https://billing.stripe.com/') === 0) {
          window.open(d.url, '_blank', 'noopener');
        } else { throw new Error('bad url'); }
      })
      .catch(function () { document.getElementById('portal-err').style.display = 'block'; })
      .finally(function () { btn.disabled = false; });
  });
})();
(function () {
  var openBtn = document.getElementById('cancel-open');
  var dialog = document.getElementById('cancel-dialog');
  var backBtn = document.getElementById('cancel-back');
  var confirmBtn = document.getElementById('cancel-confirm');
  var err = document.getElementById('cancel-err');
  var reservationNote = document.getElementById('cancel-reservation-note');
  var reservationToken = null;
  if (!openBtn || !dialog || !backBtn || !confirmBtn) return;
  function currentReservationToken() {
    try {
      var stateElement = document.getElementById('plan-change-state');
      var state = stateElement && JSON.parse(stateElement.textContent);
      return state && typeof state.cancellation_token === 'string' && state.cancellation_token ? state.cancellation_token : null;
    } catch (_) { return null; }
  }
  function hideDialog() { dialog.hidden = true; reservationToken = null; }
  openBtn.addEventListener('click', function () {
    if (err) err.style.display = 'none';
    reservationToken = currentReservationToken();
    if (reservationNote) reservationNote.hidden = !reservationToken;
    dialog.hidden = false;
  });
  backBtn.addEventListener('click', hideDialog);
  confirmBtn.addEventListener('click', function () {
    if (confirmBtn.disabled || dialog.hidden) return;
    confirmBtn.disabled = true;
    var options = { method: 'POST', credentials: 'same-origin' };
    if (reservationToken) {
      options.headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
      options.body = JSON.stringify({ reservation_token: reservationToken });
    }
    fetch(window.location.pathname + '/cancel' + window.location.search, options)
      .then(function (r) {
        return r.json().then(function (d) {
          if (!r.ok) {
            var failure = new Error(d && typeof d.message === 'string' ? d.message : '解約できませんでした。時間をおいて再度お試しください。');
            failure.toybacoMessage = true;
            throw failure;
          }
          return d;
        });
      })
      .then(function (d) {
        if (!d || d.cancelled !== true) throw new Error('not cancelled');
        hideDialog();
        openBtn.hidden = true;
        var planPanel = document.getElementById('plan-change-panel');
        if (planPanel) planPanel.hidden = true;
        if (!document.getElementById('cancel-done')) {
          var done = document.createElement('p');
          done.id = 'cancel-done';
          done.className = 'note';
          done.textContent = 'お申し出以降、次回分の請求は発生しません。日割りの返金はありません。';
          openBtn.parentNode.appendChild(done);
        }
      })
      .catch(function (error) {
        hideDialog();
        if (err) {
          err.textContent = error.toybacoMessage ? error.message : '解約できませんでした。時間をおいて再度お試しください。';
          err.style.display = 'block';
        }
        openBtn.focus();
      })
      .finally(function () { confirmBtn.disabled = false; });
  });
})();
</script>
</body>
</html>
