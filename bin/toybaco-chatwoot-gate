#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly CHATWOOT_SOURCE_TAG='v4.17.1'
readonly CHATWOOT_SOURCE_TAG_OBJECT='e194a693e2dbf4ebae5f78a4d3b9bf6dd8b53ff1'
readonly CHATWOOT_SOURCE_COMMIT='b354a9550e1fb59fa537a9c384232cb076213e72'
readonly CHATWOOT_SOURCE_TREE='9a17426900d328a6acc2bdaecba0533e8b401120'
readonly CHATWOOT_PREVIOUS_TAG='v4.16.2'
readonly CHATWOOT_PREVIOUS_TAG_OBJECT='e5d374f1186f8c0b7eac10fb7649f380c89a6da9'
readonly CHATWOOT_PREVIOUS_COMMIT='70e284a044f00326725f65f703162745371075ec'
readonly CHATWOOT_PREVIOUS_TREE='5dcb62d1588bd247a103bd8c0ef772b9c3d69948'
readonly CHATWOOT_SOURCE_URL='https://github.com/chatwoot/chatwoot.git'
readonly CHATWOOT_IMAGE='chatwoot/chatwoot@sha256:0dcaaacc41ba5219b48af80b236f7707dbd5d58228320950af71a4309c349a7a'
readonly POSTGRES_IMAGE='pgvector/pgvector:pg16@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b'
readonly REDIS_IMAGE='redis:7.4.5-alpine@sha256:bb186d083732f669da90be8b0f975a37812b15e913465bb14d845db72a4e3e08'
readonly EXPECTED_MIN_INTEGRATION_RUBY_FILES=14
readonly EXPECTED_MIN_SPEC_FILES=5
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
SOURCE=''
ARTIFACT_DIR=''
CONTROL_SHA_ONLY=0
QUALITY_ONLY=1
STAGE='初期化'
RUN_ROOT=''
CONTROL_ROOT=''
CLEAN_SOURCE=''
PATCHED_SOURCE=''
TEST_CONTEXT=''
CONTROL_MANIFEST=''
CONTROL_MANIFEST_SHA=''
CLEAN_SOURCE_FINGERPRINT=''
SEED_FINGERPRINT=''
NETWORK_NAME=''
POSTGRES_NAME=''
REDIS_NAME=''
TEST_IMAGE=''
PRODUCTION_IMAGE=''
POSTGRES_TEST_PASSWORD=''
SYNC_TEST_PASSWORD=''
RAILS_NAME=''
SIDEKIQ_NAME=''

usage() {
  cat <<'EOF'
使い方: bin/toybaco-chatwoot-gate [--quality-only] [--source <固定Chatwootのclean clone>]
        bin/toybaco-chatwoot-gate --control-sha-only

引数なしなら公開upstreamから固定commitを隔離取得する。
--source はネットワーク取得を省くread-only seedで、固定HEAD/tree・clean状態・
ignored file不在を確認してから別cloneを使う。seed自身は変更しない。

固定image/source、全Toybaco RSpec、Rubocop、frame-policy、production imageの
build/boot smokeを、AWS・Cloudflare・本番秘密なしで一括検証する。
旧--artifact-dir release bundleはowner再baselineでpark済みのため使用できない。
EOF
}

fail() {
  echo "ERROR[$STAGE]: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "必要なcommandがありません: $1"
}

sha256_file() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 -r "$file" | awk '{print $1}'
  else
    fail 'SHA-256実装(sha256sum/shasum/openssl)がありません'
  fi
}

assert_regular_path() {
  local source_root="$1"
  local relative_path="$2"
  local component
  local current="$source_root"
  local old_ifs="$IFS"

  IFS='/'
  for component in $relative_path; do
    current="$current/$component"
    [[ ! -L "$current" ]] || fail "allowlist pathにsymlinkがあります: $relative_path"
  done
  IFS="$old_ifs"
  [[ -f "$current" ]] || fail "allowlist対象が通常ファイルではありません: $relative_path"
}

control_file_list() {
  local source_root="$1"

  printf '%s\n' \
    '.dockerignore' \
    'Dockerfile' \
    'bin/toybaco-chatwoot-gate' \
    'infra/terraform/ecs.tf' \
    'scripts/generate-chatwoot-active-ja-overrides.rb' \
    'scripts/generate-chatwoot-ja-overrides.rb' \
    'tests/chatwoot_full_japanese_test.rb' \
    'tests/chatwoot-http-smoke.rb' \
    'tests/chatwoot-migrations-v4.16.2-to-v4.17.1.json' \
    'tests/chatwoot-overlay-manifest.tsv' \
    'tests/chatwoot-rspec-manifest.json' \
    'tests/chatwoot-test.Dockerfile' \
    'tests/chatwoot_frame_policy_test.rb' \
    'tests/chatwoot-production-smoke.rb' \
    'tests/postiz_identity_contract.sql' \
    'tests/verify_chatwoot_auth_cookie.rb' \
    'tests/verify_chatwoot_migration_contract.rb' \
    'tests/verify_chatwoot_overlay_manifest.rb' \
    'tests/verify_chatwoot_rspec_result.rb'

  ruby "$source_root/tests/verify_chatwoot_overlay_manifest.rb" files "$source_root" \
    "$source_root/tests/chatwoot-overlay-manifest.tsv"
}

control_manifest() {
  local source_root="$1"
  local relative_path
  local count=0

  while IFS= read -r relative_path; do
    [[ -n "$relative_path" ]] || fail 'allowlistに空pathがあります'
    case "$relative_path" in
      *$'\n'*) fail "改行を含むpathは許可しません: $relative_path" ;;
    esac
    assert_regular_path "$source_root" "$relative_path"
    printf '%s  %s\n' "$(sha256_file "$source_root/$relative_path")" "$relative_path"
    count=$((count + 1))
  done < <(control_file_list "$source_root")

  [[ "$count" -ge 10 ]] || fail "control snapshotのfile数が不正です: $count"
}

integration_ruby_file_list() {
  local source_root="$1"

  (
    cd "$source_root"
    {
      find overlay/app/app/controllers/toybaco -type f -name '*.rb' -print
      find overlay/app/config/initializers -maxdepth 1 -type f \
        \( -name 'toybaco_oidc.rb' -o -name 'toybaco_frame_policy.rb' -o \
        -name 'toybaco_postiz_lifecycle.rb' \) -print
      find overlay/app/lib/toybaco -maxdepth 1 -type f \
        \( -name 'postiz*.rb' -o -name 'dashboard_frame_policy.rb' \) -print
      find overlay/app/lib/toybaco/oidc -type f -name '*.rb' -print
      find overlay/app/spec -type f -name '*_spec.rb' -print
    } | LC_ALL=C sort -u
  )
}

copy_control_snapshot() {
  local relative_path

  mkdir -p "$CONTROL_ROOT"
  while IFS= read -r relative_path; do
    mkdir -p "$CONTROL_ROOT/$(dirname "$relative_path")"
    cp -p "$ROOT/$relative_path" "$CONTROL_ROOT/$relative_path"
  done < <(control_file_list "$ROOT")

  # umask 077で作ったsnapshotをLinux上の非root containerからread-only mountしても
  # traverse/readできるよう正規化する。内容・実行bitは変えない。
  find "$CONTROL_ROOT" -type d -exec chmod 0755 {} +
  find "$CONTROL_ROOT" -type f -exec chmod u=rwX,go=rX {} +
  # BuildKit COPYへdirectory/file mtimeが入るため、同じsourceから同じ内容を作れるよう
  # 検証対象overlayの時刻を固定する。
  find "$CONTROL_ROOT/overlay/app" -exec touch -t 200001010000.00 {} +
}

assert_single_exact_line() {
  local file="$1"
  local expected="$2"
  local count

  count="$(grep -Fxc "$expected" "$file" || true)"
  [[ "$count" -eq 1 ]] || fail "固定契約行がexact 1件ではありません: $expected"
}

assert_node_heap_precompile_block() {
  local dockerfile="$1"

  ruby - "$dockerfile" <<'RUBY'
lines = File.readlines(ARGV.fetch(0), chomp: true)
expected = [
  '    && SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=enabled \\',
  '      NODE_OPTIONS=--max-old-space-size=4096 \\',
  '      bundle exec rake assets:precompile \\'
]
matches = lines.each_cons(expected.length).count { |block| block == expected }
abort 'Node heap上限がassets:precompileへexactに適用されていません' unless matches == 1
RUBY
}

assert_control_contract() {
  local sentinel
  local required_path
  local integration_ruby_count
  local spec_count

  STAGE='quality control契約'
  ruby "$CONTROL_ROOT/tests/verify_chatwoot_overlay_manifest.rb" verify "$CONTROL_ROOT" \
    "$CONTROL_ROOT/tests/chatwoot-overlay-manifest.tsv"
  if find "$CONTROL_ROOT/overlay/app" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
    fail 'overlay/appに通常file/directory以外があります'
  fi
  if find "$CONTROL_ROOT" -type f \( \
    -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.key' -o \
    -name 'id_rsa' -o -iname '*credential*' \) -print -quit | grep -q .; then
    fail 'secretになり得るfile名をquality snapshotへ含めません'
  fi
  if LC_ALL=C grep -R -I -E \
    -- '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----|(^|[^A-Z0-9])(AKIA|ASIA)[A-Z0-9]{16}([^A-Z0-9]|$)' \
    "$CONTROL_ROOT" >/dev/null 2>&1; then
    fail 'quality snapshotに秘密鍵またはAWS access key形式の文字列があります'
  fi

  assert_single_exact_line "$CONTROL_ROOT/Dockerfile" \
    "ARG CHATWOOT_IMAGE=$CHATWOOT_IMAGE"
  grep -Fq "org.opencontainers.image.revision=\"$CHATWOOT_SOURCE_COMMIT\"" \
    "$CONTROL_ROOT/Dockerfile" || fail 'production Dockerfileのsource revision labelが固定値ではありません'
  grep -Fq 'org.opencontainers.image.source="https://github.com/Cyber-relations/chatwoot"' \
    "$CONTROL_ROOT/Dockerfile" || fail 'production Dockerfileの公開source labelが固定値ではありません'
  grep -Fq "jp.toybaco.source.tree=\"$CHATWOOT_SOURCE_TREE\"" "$CONTROL_ROOT/Dockerfile" || fail \
    'production Dockerfileのsource tree labelが固定値ではありません'
  assert_single_exact_line "$CONTROL_ROOT/.dockerignore" 'overlay/app/spec/**'
  assert_single_exact_line "$CONTROL_ROOT/tests/chatwoot-test.Dockerfile" \
    "ARG CHATWOOT_IMAGE=$CHATWOOT_IMAGE"
  ruby -c "$CONTROL_ROOT/scripts/generate-chatwoot-ja-overrides.rb" >/dev/null || fail \
    'Chatwoot日本語生成scriptのRuby syntaxが不正です'
  ruby -c "$CONTROL_ROOT/scripts/generate-chatwoot-active-ja-overrides.rb" >/dev/null || fail \
    'Chatwoot主要画面日本語生成scriptのRuby syntaxが不正です'
  grep -Fq "musl-utils=1.2.5-r11" "$CONTROL_ROOT/Dockerfile" || fail \
    'production Dockerfileのmusl-utils修正版が固定されていません'
  grep -Fq "zlib=1.3.2-r0" "$CONTROL_ROOT/Dockerfile" || fail \
    'production Dockerfileのzlib修正版が固定されていません'
  grep -Fq 'cp -a /usr/lib/libz.so.1 /usr/lib/libz.so.1.3.2 /toybaco-runtime-root/usr/lib/' \
    "$CONTROL_ROOT/Dockerfile" || fail 'production Dockerfileが修正版zlib実体をfinal stageへコピーしません'
  grep -Fq 'test ! -e /usr/lib/libz.so.1.3.1' "$CONTROL_ROOT/Dockerfile" || fail \
    'production Dockerfileが旧zlib実体を拒否しません'
  assert_node_heap_precompile_block "$CONTROL_ROOT/Dockerfile" || fail \
    'production Vite buildのNode heap上限がassets:precompileへ固定されていません'
  grep -Fq -- "-type f -name '*.js'" "$CONTROL_ROOT/Dockerfile" || fail \
    'production asset検証がserved JavaScriptだけに限定されていません'
  for sentinel in 'トイバコサーバー' '新しいチャットを開始する' '評価のご協力ありがとうございます。'; do
    grep -Fq "'$sentinel'" "$CONTROL_ROOT/Dockerfile" || fail \
      "production日本語served JS assetの実在検証がありません: $sentinel"
  done
  grep -Fq "'Woot[[:space:]]*サーバー|Chatwootにログイン'" "$CONTROL_ROOT/Dockerfile" || fail \
    'production日本語served JS assetの旧brand文言拒否がありません'
  grep -Fq "defaults={sameSite:\"Lax\",secure:!0}" "$CONTROL_ROOT/Dockerfile" || fail \
    'production auth bundleのSecure cookie検証がありません'
  assert_single_exact_line "$CONTROL_ROOT/Dockerfile" \
    'FROM ${CHATWOOT_IMAGE} AS overlay-normalizer'
  assert_single_exact_line "$CONTROL_ROOT/Dockerfile" \
    'RUN find /toybaco-overlay -exec touch -t 200001010000.00 {} +'
  assert_single_exact_line "$CONTROL_ROOT/Dockerfile" \
    'COPY --from=overlay-normalizer /toybaco-overlay/ /app/'
  assert_single_exact_line "$CONTROL_ROOT/Dockerfile" 'RUN rm -rf /app/public/vite'

  ruby "$CONTROL_ROOT/tests/verify_chatwoot_auth_cookie.rb" source \
    "$CONTROL_ROOT/overlay/app/app/javascript/dashboard/store/utils/api.js" \
    "$CONTROL_ROOT/overlay/app/public/brand-assets/toybaco-post-entry.js"
  sed 's/secure: true/secure: false/g' \
    "$CONTROL_ROOT/overlay/app/app/javascript/dashboard/store/utils/api.js" \
    > "$RUN_ROOT/insecure-delayed-login-api.js"
  if ruby "$CONTROL_ROOT/tests/verify_chatwoot_auth_cookie.rb" source \
    "$RUN_ROOT/insecure-delayed-login-api.js" \
    "$CONTROL_ROOT/overlay/app/public/brand-assets/toybaco-post-entry.js" >/dev/null 2>&1; then
    fail '遅延loginで非Secure auth cookieを作る負例をverifierが拒否しません'
  fi

  for required_path in \
    'overlay/app/spec/requests/toybaco/oidc_spec.rb' \
    'overlay/app/spec/lib/toybaco/postiz_sync_spec.rb' \
    'overlay/app/spec/lib/toybaco/postiz_sync_database_spec.rb' \
    'overlay/app/spec/lib/toybaco/oidc/session_reader_spec.rb' \
    'overlay/app/spec/models/toybaco/postiz_lifecycle_spec.rb'; do
    [[ -f "$CONTROL_ROOT/$required_path" ]] || fail "必須Toybaco specがありません: $required_path"
  done
  integration_ruby_count="$(integration_ruby_file_list "$CONTROL_ROOT" | wc -l | tr -d ' ')"
  spec_count="$(find "$CONTROL_ROOT/overlay/app/spec" -type f -name '*_spec.rb' | wc -l | tr -d ' ')"
  [[ "$integration_ruby_count" -ge "$EXPECTED_MIN_INTEGRATION_RUBY_FILES" ]] || fail \
    "統合境界Ruby allowlistが縮退しています: $integration_ruby_count"
  [[ "$spec_count" -ge "$EXPECTED_MIN_SPEC_FILES" ]] || fail "Toybaco spec名簿が縮退しています: $spec_count"

  sh -n "$CONTROL_ROOT/overlay/app/bin/toybaco-chatwoot-schema-preflight" || fail \
    'Chatwoot schema preflightのshell syntaxが不正です'
  bash -n "$CONTROL_ROOT/bin/toybaco-chatwoot-gate"
  ruby -c "$CONTROL_ROOT/tests/verify_chatwoot_migration_contract.rb" >/dev/null
}

git_source_fingerprint() {
  local source_root="$1"

  printf 'HEAD %s\n' "$(git -C "$source_root" rev-parse HEAD)"
  printf 'TREE %s\n' "$(git -C "$source_root" rev-parse 'HEAD^{tree}')"
  git -C "$source_root" ls-files --stage
  git -C "$source_root" status --porcelain=v2 --untracked-files=all
  git -C "$source_root" ls-files --others --ignored --exclude-standard
}

assert_clean_source() {
  local source_root="$1"
  local actual_commit
  local actual_tree

  git -C "$source_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail \
    "Chatwoot sourceはGit worktreeではありません: $source_root"
  actual_commit="$(git -C "$source_root" rev-parse HEAD)"
  actual_tree="$(git -C "$source_root" rev-parse 'HEAD^{tree}')"
  [[ "$actual_commit" == "$CHATWOOT_SOURCE_COMMIT" ]] || fail \
    "Chatwoot source HEADが固定commitではありません: $actual_commit"
  [[ "$actual_tree" == "$CHATWOOT_SOURCE_TREE" ]] || fail \
    "Chatwoot source treeが固定値ではありません: $actual_tree"
  [[ -z "$(git -C "$source_root" status --porcelain=v1 --untracked-files=all)" ]] || fail \
    "Chatwoot sourceに未commit変更があります: $source_root"
  [[ -z "$(git -C "$source_root" ls-files --others --ignored --exclude-standard)" ]] || fail \
    "Chatwoot sourceにignored fileがあります: $source_root"
  [[ ! -e "$source_root/.git/objects/info/alternates" ]] || fail \
    "隔離sourceが外部object storeを参照しています: $source_root"
}

acquire_source() {
  local source_path

  STAGE='固定Chatwoot source取得'
  if [[ -n "$SOURCE" ]]; then
    [[ -d "$SOURCE" ]] || fail "--source directoryがありません: $SOURCE"
    source_path="$(cd "$SOURCE" && pwd -P)"
    assert_clean_source "$source_path"
    SEED_FINGERPRINT="$RUN_ROOT/seed.fingerprint"
    git_source_fingerprint "$source_path" > "$SEED_FINGERPRINT"
    git -c advice.detachedHead=false clone --quiet --no-hardlinks "$source_path" "$CLEAN_SOURCE"
  else
    git init --quiet "$CLEAN_SOURCE"
    git -C "$CLEAN_SOURCE" remote add origin "$CHATWOOT_SOURCE_URL"
    git -C "$CLEAN_SOURCE" fetch --quiet --depth 1 origin \
      "refs/tags/$CHATWOOT_PREVIOUS_TAG:refs/tags/$CHATWOOT_PREVIOUS_TAG" \
      "refs/tags/$CHATWOOT_SOURCE_TAG:refs/tags/$CHATWOOT_SOURCE_TAG"
    [[ "$(git -C "$CLEAN_SOURCE" rev-parse "refs/tags/$CHATWOOT_SOURCE_TAG")" == \
      "$CHATWOOT_SOURCE_TAG_OBJECT" ]] || fail '固定Chatwoot annotated tag objectが不一致です'
    [[ "$(git -C "$CLEAN_SOURCE" rev-parse "refs/tags/$CHATWOOT_SOURCE_TAG^{commit}")" == \
      "$CHATWOOT_SOURCE_COMMIT" ]] || fail '固定Chatwoot tagのpeeled commitが不一致です'
    git -C "$CLEAN_SOURCE" checkout --quiet --detach "$CHATWOOT_SOURCE_COMMIT"
  fi
  rm -f "$CLEAN_SOURCE/.git/objects/info/alternates"
  [[ "$(git -C "$CLEAN_SOURCE" rev-parse "refs/tags/$CHATWOOT_PREVIOUS_TAG")" == \
    "$CHATWOOT_PREVIOUS_TAG_OBJECT" ]] || fail 'previous Chatwoot annotated tag objectが不一致です'
  [[ "$(git -C "$CLEAN_SOURCE" rev-parse "refs/tags/$CHATWOOT_PREVIOUS_TAG^{commit}")" == \
    "$CHATWOOT_PREVIOUS_COMMIT" ]] || fail 'previous Chatwoot commitが不一致です'
  [[ "$(git -C "$CLEAN_SOURCE" rev-parse "refs/tags/$CHATWOOT_PREVIOUS_TAG^{tree}")" == \
    "$CHATWOOT_PREVIOUS_TREE" ]] || fail 'previous Chatwoot treeが不一致です'
  assert_clean_source "$CLEAN_SOURCE"
  CLEAN_SOURCE_FINGERPRINT="$RUN_ROOT/clean-source.fingerprint"
  git_source_fingerprint "$CLEAN_SOURCE" > "$CLEAN_SOURCE_FINGERPRINT"
}

assert_overlay_application() {
  local allowed_paths="$RUN_ROOT/allowed-overlay-paths"
  local current_fingerprint="$RUN_ROOT/patched-source.fingerprint"
  local relative_path
  local source_relative

  STAGE='overlay境界検証'
  ruby "$CONTROL_ROOT/tests/verify_chatwoot_overlay_manifest.rb" files "$CONTROL_ROOT" \
    "$CONTROL_ROOT/tests/chatwoot-overlay-manifest.tsv" | sed 's#^overlay/app/##' > "$allowed_paths"

  while IFS= read -r relative_path; do
    source_relative="${relative_path#overlay/app/}"
    mkdir -p "$PATCHED_SOURCE/$(dirname "$source_relative")"
    cp -p "$CONTROL_ROOT/$relative_path" "$PATCHED_SOURCE/$source_relative"
  done < <(control_file_list "$CONTROL_ROOT" | grep '^overlay/app/')

  while IFS= read -r source_relative; do
    [[ "$(sha256_file "$CONTROL_ROOT/overlay/app/$source_relative")" == \
      "$(sha256_file "$PATCHED_SOURCE/$source_relative")" ]] || fail \
      "overlay適用後のSHA-256が不一致です: $source_relative"
  done < "$allowed_paths"

  while IFS= read -r -d '' source_relative; do
    grep -Fqx "$source_relative" "$allowed_paths" || fail \
      "overlay以外のtracked pathが変更されました: $source_relative"
  done < <(git -C "$PATCHED_SOURCE" diff --name-only -z HEAD --)
  while IFS= read -r -d '' source_relative; do
    grep -Fqx "$source_relative" "$allowed_paths" || fail \
      "overlay以外のuntracked pathが作られました: $source_relative"
  done < <(git -C "$PATCHED_SOURCE" ls-files --others --exclude-standard -z)

  [[ -z "$(git -C "$PATCHED_SOURCE" diff --name-only --diff-filter=D HEAD --)" ]] || fail \
    'overlay適用でupstream fileが削除されました'
  [[ -z "$(git -C "$PATCHED_SOURCE" ls-files --others --ignored --exclude-standard)" ]] || fail \
    'patched sourceにignored fileが作られました'
  git -C "$PATCHED_SOURCE" diff --check
  git_source_fingerprint "$PATCHED_SOURCE" > "$current_fingerprint"
}

wait_for_healthy() {
  local container="$1"
  local attempt=0
  local health
  local running

  while [[ "$attempt" -lt 90 ]]; do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}' "$container" 2>/dev/null || true)"
    running="$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)"
    [[ "$health" != 'healthy' ]] || return 0
    [[ "$running" == 'true' ]] || {
      docker logs "$container" >&2 || true
      fail "containerがhealthcheck前に終了しました: $container"
    }
    sleep 1
    attempt=$((attempt + 1))
  done
  docker logs "$container" >&2 || true
  fail "containerが90秒以内にhealthyになりません: $container ($health)"
}

start_services() {
  STAGE='使い捨てPostgres/Redis起動'
  docker network create --internal "$NETWORK_NAME" >/dev/null
  docker run --detach \
    --name "$POSTGRES_NAME" \
    --network "$NETWORK_NAME" \
    --network-alias postgres \
    --env POSTGRES_USER=postgres \
    --env "POSTGRES_PASSWORD=$POSTGRES_TEST_PASSWORD" \
    --env POSTGRES_DB=postgres \
    --tmpfs /var/lib/postgresql/data:rw,nosuid,size=2g \
    --health-cmd='pg_isready -U postgres -d postgres' \
    --health-interval=1s \
    --health-timeout=5s \
    --health-retries=60 \
    "$POSTGRES_IMAGE" >/dev/null
  docker run --detach \
    --name "$REDIS_NAME" \
    --network "$NETWORK_NAME" \
    --network-alias redis \
    --read-only \
    --tmpfs /data:rw,nosuid,size=128m \
    --tmpfs /tmp:rw,nosuid,size=32m \
    --health-cmd='redis-cli ping' \
    --health-interval=1s \
    --health-timeout=5s \
    --health-retries=60 \
    "$REDIS_IMAGE" redis-server --save '' --appendonly no >/dev/null
  wait_for_healthy "$POSTGRES_NAME"
  wait_for_healthy "$REDIS_NAME"
}

create_test_databases() {
  STAGE='test database作成'
  docker exec "$POSTGRES_NAME" createdb -U postgres chatwoot_test
  docker exec "$POSTGRES_NAME" createdb -U postgres postiz_identity_test
  docker exec -i "$POSTGRES_NAME" psql --set ON_ERROR_STOP=1 -U postgres -d postiz_identity_test \
    < "$CONTROL_ROOT/tests/postiz_identity_contract.sql"
  docker exec "$POSTGRES_NAME" psql --set ON_ERROR_STOP=1 -U postgres -d postiz_identity_test -c \
    "CREATE ROLE toybaco_sync_gate LOGIN PASSWORD '$SYNC_TEST_PASSWORD'"
  docker exec "$POSTGRES_NAME" psql --set ON_ERROR_STOP=1 -U postgres -d postiz_identity_test -c \
    'GRANT USAGE ON SCHEMA public TO toybaco_sync_gate; GRANT USAGE ON TYPE "Provider", "Role", "ShortLinkPreference" TO toybaco_sync_gate; GRANT SELECT, INSERT, UPDATE ON "Organization", "User", "UserOrganization" TO toybaco_sync_gate'
}

