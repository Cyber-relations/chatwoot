run_production_container() {
  local env_args=()
  local value

  while IFS= read -r value; do
    env_args[${#env_args[@]}]="$value"
  done < <(production_env_args)
  docker run --rm \
    --network "$NETWORK_NAME" \
    --read-only \
    --tmpfs /tmp:rw,nosuid,size=256m \
    --tmpfs /app/tmp:rw,nosuid,size=256m \
    --tmpfs /app/log:rw,nosuid,size=64m \
    --tmpfs /app/storage:rw,nosuid,size=128m \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    "${env_args[@]}" \
    "$@"
}

start_production_service() {
  local name="$1"
  local network_alias="$2"
  shift 2
  local env_args=()
  local value

  while IFS= read -r value; do
    env_args[${#env_args[@]}]="$value"
  done < <(production_env_args)
  docker run --detach \
    --name "$name" \
    --network "$NETWORK_NAME" \
    --network-alias "$network_alias" \
    --read-only \
    --tmpfs /tmp:rw,nosuid,size=256m \
    --tmpfs /app/tmp:rw,nosuid,size=256m \
    --tmpfs /app/log:rw,nosuid,size=64m \
    --tmpfs /app/storage:rw,nosuid,size=128m \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    "${env_args[@]}" \
    "$PRODUCTION_IMAGE" "$@"
}

wait_for_rails_port() {
  local attempt=0
  while [[ "$attempt" -lt 90 ]]; do
    if ! docker inspect --format '{{.State.Running}}' "$RAILS_NAME" 2>/dev/null | grep -qx true; then
      docker logs "$RAILS_NAME" >&2 || true
      fail 'Puma containerが起動中に終了しました'
    fi
    if docker exec "$RAILS_NAME" ruby -rsocket -e \
      'socket = TCPSocket.new("127.0.0.1", 3000); socket.close' >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  docker logs "$RAILS_NAME" >&2 || true
  fail 'Pumaが90秒以内にlistenしません'
}

verify_base_and_frame_contract() {
  local actual_revision
  local frame_output

  STAGE='固定Chatwoot image/frame-policy契約'
  docker pull --platform linux/amd64 "$CHATWOOT_IMAGE" >/dev/null
  [[ "$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$CHATWOOT_IMAGE")" == 'linux/amd64' ]] || \
    fail '固定Chatwoot imageがlinux/amd64ではありません'
  actual_revision="$(docker run --rm --platform linux/amd64 --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges "$CHATWOOT_IMAGE" sh -c 'cat /app/.git_sha')"
  [[ "$actual_revision" == "$CHATWOOT_SOURCE_COMMIT" ]] || fail \
    "固定Chatwoot imageとsource commitが一致しません: $actual_revision"

  frame_output="$(docker run --rm --platform linux/amd64 --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges \
    --mount "type=bind,src=$CONTROL_ROOT,dst=/contract,readonly" \
    --workdir /contract "$CHATWOOT_IMAGE" ruby tests/chatwoot_frame_policy_test.rb)"
  printf '%s\n' "$frame_output"
  grep -Eq '5 runs, 36 assertions, 0 failures, 0 errors, 0 skips' <<< "$frame_output" || fail \
    'frame-policy contractのrun/assertion数または結果が不正です'
}

build_test_image() {
  local relative_path
  local source_relative

  STAGE='固定source test image build'
  mkdir -p "$TEST_CONTEXT"
  git -C "$CLEAN_SOURCE" archive HEAD | tar -x -C "$TEST_CONTEXT"
  [[ ! -e "$TEST_CONTEXT/.git" ]] || fail 'test build contextへ.gitを持ち込みません'
  while IFS= read -r relative_path; do
    source_relative="${relative_path#overlay/app/}"
    mkdir -p "$TEST_CONTEXT/$(dirname "$source_relative")"
    cp -p "$CONTROL_ROOT/$relative_path" "$TEST_CONTEXT/$source_relative"
    [[ "$(sha256_file "$CONTROL_ROOT/$relative_path")" == \
      "$(sha256_file "$TEST_CONTEXT/$source_relative")" ]] || fail \
      "test build contextのoverlay SHA-256が不一致です: $source_relative"
  done < <(control_file_list "$CONTROL_ROOT" | grep '^overlay/app/')

  DOCKER_BUILDKIT=1 docker build --pull --platform linux/amd64 \
    --file "$CONTROL_ROOT/tests/chatwoot-test.Dockerfile" \
    --build-arg "CHATWOOT_IMAGE=$CHATWOOT_IMAGE" \
    --build-arg "CHATWOOT_SOURCE_COMMIT=$CHATWOOT_SOURCE_COMMIT" \
    --build-arg "TOYBACO_CONTROL_SHA256=$CONTROL_MANIFEST_SHA" \
    --tag "$TEST_IMAGE" \
    "$TEST_CONTEXT"

  [[ "$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$TEST_IMAGE")" == \
    "$CHATWOOT_SOURCE_COMMIT" ]] || fail 'test imageのsource labelが不一致です'
  [[ "$(docker image inspect --format '{{ index .Config.Labels "jp.toybaco.gate.control-sha256" }}' "$TEST_IMAGE")" == \
    "$CONTROL_MANIFEST_SHA" ]] || fail 'test imageのcontrol snapshot labelが不一致です'
  [[ "$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$TEST_IMAGE")" == 'linux/amd64' ]] || \
    fail 'test imageがlinux/amd64ではありません'
  docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
    "$TEST_IMAGE" test ! -e /app/.git
}

run_ruby_quality() {
  local ruby_files=()
  local spec_files=()
  local relative_path
  local results="$RUN_ROOT/results"

  mkdir -p "$results"
  # bind mount先のChatwoot非root userがRSpec JSONを作れる使い捨てdirectory。
  # RUN_ROOT自体は0700のためhost上で公開されない。
  chmod 0777 "$results"
  while IFS= read -r relative_path; do
    ruby_files[${#ruby_files[@]}]="${relative_path#overlay/app/}"
  done < <(
    cd "$CONTROL_ROOT"
    integration_ruby_file_list "$CONTROL_ROOT"
  )
  while IFS= read -r relative_path; do
    spec_files[${#spec_files[@]}]="${relative_path#overlay/app/}"
  done < <(ruby -rjson -e \
    'JSON.parse(File.read(ARGV.fetch(0))).fetch("spec_files").each { |path| puts "overlay/app/#{path}" }' \
    "$CONTROL_ROOT/tests/chatwoot-rspec-manifest.json")

  STAGE='Chatwoot schema準備'
  run_test_container "$TEST_IMAGE" bundle exec rails db:schema:load
  run_test_container "$TEST_IMAGE" bundle exec rails runner \
    'ActiveRecord.dump_schema_after_migration = false; Rails.application.load_tasks; Rake::Task["db:migrate"].invoke'

  STAGE='統合境界Ruby syntax/Rubocop'
  run_test_container "$TEST_IMAGE" sh -c \
    'for file do ruby -c "$file" >/dev/null || exit; done' sh "${ruby_files[@]}"
  run_test_container --env RUBOCOP_CACHE_ROOT=/tmp/rubocop-cache "$TEST_IMAGE" \
    bundle exec rubocop --force-exclusion --format progress "${ruby_files[@]}"

  STAGE='全Toybaco RSpec'
  run_test_container \
    --mount "type=bind,src=$results,dst=/results" \
    "$TEST_IMAGE" bundle exec rspec \
    --format progress --format json --out /results/rspec.json "${spec_files[@]}"

  [[ -s "$results/rspec.json" ]] || fail 'RSpec JSON結果が作られませんでした'
  docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges \
    --mount "type=bind,src=$CONTROL_ROOT,dst=/contract,readonly" \
    --mount "type=bind,src=$results,dst=/results,readonly" \
    "$TEST_IMAGE" ruby /contract/tests/verify_chatwoot_rspec_result.rb \
    /results/rspec.json /contract/tests/chatwoot-rspec-manifest.json
}

build_and_smoke_production_image() {
  local actual_base_label
  local actual_revision_label
  local base_count
  local production_count
  local sidekiq_count
  local sidekiq_deadline
  local sidekiq_identity
  local sidekiq_info
  local relative_path
  local hash
  local production_contract="$RUN_ROOT/production-contract"
  local production_manifest="$production_contract/production-overlay.sha256"
  local production_ruby_files="$production_contract/production-ruby-files"

  STAGE='production linux/amd64 quality build'
  # quality laneはproduction Dockerfileそのものを通常のBuildKitでbuildしてruntime smokeする。
  # release用OCI archive/SBOM/provenanceはparkし、publisher jobだけがbuildxを一度実行する。
  DOCKER_BUILDKIT=1 docker build --no-cache --pull --platform linux/amd64 \
    --file "$CONTROL_ROOT/Dockerfile" \
    --build-arg "CHATWOOT_IMAGE=$CHATWOOT_IMAGE" \
    --build-arg "TOYBACO_CONTROL_SHA256=$CONTROL_MANIFEST_SHA" \
    --tag "$PRODUCTION_IMAGE" \
    "$CONTROL_ROOT"

  actual_base_label="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.base.name" }}' "$PRODUCTION_IMAGE")"
  actual_revision_label="$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$PRODUCTION_IMAGE")"
  [[ "$actual_base_label" == "$CHATWOOT_IMAGE" ]] || fail "production imageのbase labelが不一致です: $actual_base_label"
  [[ "$actual_revision_label" == "$CHATWOOT_SOURCE_COMMIT" ]] || fail \
    "production imageのrevision labelが不一致です: $actual_revision_label"
  [[ "$(docker image inspect --format '{{ index .Config.Labels "jp.toybaco.source.tree" }}' "$PRODUCTION_IMAGE")" == \
    "$CHATWOOT_SOURCE_TREE" ]] || fail 'production imageのsource tree labelが不一致です'
  [[ "$(docker image inspect --format '{{ index .Config.Labels "jp.toybaco.gate.control-sha256" }}' "$PRODUCTION_IMAGE")" == \
    "$CONTROL_MANIFEST_SHA" ]] || fail 'production imageのcontrol labelが不一致です'
  [[ "$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$PRODUCTION_IMAGE")" == 'linux/amd64' ]] || \
    fail 'production imageがlinux/amd64ではありません'

  docker image inspect --format '{{range .RootFS.Layers}}{{println .}}{{end}}' "$CHATWOOT_IMAGE" \
    | sed '/^$/d' > "$RUN_ROOT/base-layers"
  docker image inspect --format '{{range .RootFS.Layers}}{{println .}}{{end}}' "$PRODUCTION_IMAGE" \
    | sed '/^$/d' > "$RUN_ROOT/production-layers"
  base_count="$(wc -l < "$RUN_ROOT/base-layers" | tr -d ' ')"
  production_count="$(wc -l < "$RUN_ROOT/production-layers" | tr -d ' ')"
  [[ "$production_count" -gt "$base_count" ]] || fail 'production imageにoverlay layerがありません'
  head -n "$base_count" "$RUN_ROOT/production-layers" > "$RUN_ROOT/production-base-prefix"
  cmp "$RUN_ROOT/base-layers" "$RUN_ROOT/production-base-prefix" || fail \
    'production imageのbase layer列が固定imageと一致しません'

  mkdir -m 0755 "$production_contract"
  while IFS=' ' read -r hash relative_path; do
    case "$relative_path" in
      overlay/app/spec/*) continue ;;
      overlay/app/*)
        printf '%s  /app/%s\n' "$hash" "${relative_path#overlay/app/}" >> "$production_manifest"
        case "$relative_path" in
          *.rb) printf '/app/%s\n' "${relative_path#overlay/app/}" >> "$production_ruby_files" ;;
        esac
        ;;
    esac
  done < "$CONTROL_MANIFEST"
  chmod 0644 "$production_manifest" "$production_ruby_files"

  STAGE='production image内容検証'
  docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges \
    --mount "type=bind,src=$production_contract,dst=/contract,readonly" \
    "$PRODUCTION_IMAGE" sh -c '
      test ! -e /app/spec
      sha256sum -c /contract/production-overlay.sha256
      while IFS= read -r file; do ruby -c "$file" >/dev/null; done < /contract/production-ruby-files
      test "$(cat /app/.git_sha)" = "$1"
      test "$(apk info -v | grep "^musl-[0-9]")" = "musl-1.2.5-r11"
      test "$(apk info -v | grep "^musl-utils-")" = "musl-utils-1.2.5-r11"
      test "$(apk info -v | grep "^zlib-")" = "zlib-1.3.2-r0"
      test "$(readlink /usr/lib/libz.so.1)" = "libz.so.1.3.2"
      test -f /usr/lib/libz.so.1.3.2
      test ! -e /usr/lib/libz.so.1.3.1
      test "$(apk info -v | grep "^postgresql17-client-")" = "postgresql17-client-17.11-r0"
    ' sh "$CHATWOOT_SOURCE_COMMIT"
  docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges \
    --mount "type=bind,src=$CONTROL_ROOT,dst=/contract,readonly" \
    "$PRODUCTION_IMAGE" ruby /contract/tests/verify_chatwoot_auth_cookie.rb production /

  STAGE='production image boot smoke'
  # test imageで固定sourceのschema loadは既に成功済み。接続が全て閉じた後に
  # その空schemaをcloneし、production初回boot前のinitializerが未作成tableを
  # 読んで紛らわしいERROR logを出す経路を避ける。
  docker exec "$POSTGRES_NAME" createdb -U postgres --template chatwoot_test chatwoot_smoke
  run_production_container \
    --mount "type=bind,src=$CONTROL_ROOT,dst=/contract,readonly" \
    "$PRODUCTION_IMAGE" bundle exec rails runner /contract/tests/chatwoot-production-smoke.rb

  STAGE='production Puma/HTTP/CSP/OIDC smoke'
  start_production_service "$RAILS_NAME" chatwoot bundle exec rails server -p 3000 -b 0.0.0.0 >/dev/null
  wait_for_rails_port
  run_test_container \
    --mount "type=bind,src=$CONTROL_ROOT,dst=/contract,readonly" \
    "$TEST_IMAGE" ruby /contract/tests/chatwoot-http-smoke.rb http://chatwoot:3000/
  # Pumaの実boot/HTTP検証は完了した。arm64 host上のamd64 emulationでも
  # Sidekiq+検証runnerがOOMにならないよう、次のservice smoke前に停止する。
  docker rm --force "$RAILS_NAME" >/dev/null
  RAILS_NAME=''

  STAGE='production Sidekiq実process smoke'
  start_production_service "$SIDEKIQ_NAME" sidekiq bundle exec sidekiq -C config/sidekiq.yml >/dev/null
  [[ "$(docker inspect --format '{{.State.Running}}' "$SIDEKIQ_NAME" 2>/dev/null)" == 'true' ]] || {
    docker logs "$SIDEKIQ_NAME" >&2 || true
    fail 'Sidekiq containerがboot後に稼働していません'
  }
  # 2本目のamd64 Rails runnerを同時起動するとemulation resourceを奪い、検証対象の
  # Sidekiq startupを歪める。Sidekiq自身が書くRedis process registryをnative clientで
  # pollし、同じnetwork上でexact 1 processとidentity/info JSONを非干渉確認する。
  sidekiq_deadline=$((SECONDS + 180))
  while true; do
    sidekiq_count="$(docker exec "$REDIS_NAME" redis-cli --raw SCARD processes)"
    [[ "$sidekiq_count" =~ ^[0-9]+$ ]] || fail "Sidekiq process countが数値ではありません: $sidekiq_count"
    [[ "$sidekiq_count" -le 1 ]] || fail "Unexpected Sidekiq process count: $sidekiq_count"
    [[ "$sidekiq_count" -ne 1 ]] || break
    [[ "$(docker inspect --format '{{.State.Running}}' "$SIDEKIQ_NAME" 2>/dev/null)" == 'true' ]] || {
      docker logs "$SIDEKIQ_NAME" >&2 || true
      fail 'Sidekiq containerがprocess登録前に終了しました'
    }
    [[ "$SECONDS" -lt "$sidekiq_deadline" ]] || {
      docker logs "$SIDEKIQ_NAME" >&2 || true
      fail 'Sidekiq process is not registered within 180 seconds'
    }
    sleep 1
  done
  sidekiq_identity="$(docker exec "$REDIS_NAME" redis-cli --raw SMEMBERS processes)"
  [[ -n "$sidekiq_identity" && "$sidekiq_identity" != *$'\n'* ]] || fail 'Sidekiq identityがexact 1件ではありません'
  sidekiq_info="$(docker exec "$REDIS_NAME" redis-cli --raw HGET "$sidekiq_identity" info)"
  ruby -rjson -e '
    info = JSON.parse(ARGV.fetch(0))
    abort "Sidekiq identity info mismatch" unless
      info["identity"] == ARGV.fetch(1) && info["pid"] == 1 && info["concurrency"].to_i.positive?
  ' "$sidekiq_info" "$sidekiq_identity"
  [[ "$(docker inspect --format '{{.State.Running}}' "$SIDEKIQ_NAME" 2>/dev/null)" == 'true' ]] || {
    docker logs "$SIDEKIQ_NAME" >&2 || true
    fail 'Sidekiq containerがprocess登録後に終了しました'
  }
  printf 'TOYBACO_CHATWOOT_SIDEKIQ=PASS processes=1 redis_registration=exact\n'
}

# owner再baselineでpark済み。active quality/publisherからは呼ばない。
# 履歴保存のため旧bundle実装は残すが、--artifact-dir自体をfail closedで拒否する。
publish_release_artifacts() {
  local attestation_verify_dir
  local negative
  local staging
  local release_json="$RUN_ROOT/release.json"

  [[ -n "$ARTIFACT_DIR" ]] || return 0
  STAGE='test済みrelease artifact atomic保存'
  staging="${ARTIFACT_DIR}.partial.$$"
  [[ ! -e "$ARTIFACT_DIR" && ! -L "$ARTIFACT_DIR" ]] || fail \
    "artifact出力先が既に存在します: $ARTIFACT_DIR"
  [[ ! -e "$staging" && ! -L "$staging" ]] || fail "artifact stagingが既に存在します: $staging"

  ruby -rjson -rtime -e '
    path, image_ref, digest_path, commit, tree, control, migration_contract_sha, oci_sha, docker_sha,
      metadata_sha, provenance_sha, sbom_sha = ARGV
    digests = JSON.parse(File.binread(digest_path))
    abort "OCI digest schema mismatch" unless digests.delete("schema") == "toybaco-chatwoot-oci-digests-v1"
    abort "OCI digest key set mismatch" unless
      digests.keys.sort == %w[config_digest index_digest manifest_digest]
    release = {
      schema: "toybaco-chatwoot-release-v3",
      created_at: Time.now.utc.iso8601,
      source: { tag: "v4.17.1", commit: commit, tree: tree },
      platform: "linux/amd64",
      control_sha256: control,
      migration_contract: {
        schema: "toybaco-chatwoot-migration-contract-v1",
        path: "tests/chatwoot-migrations-v4.16.2-to-v4.17.1.json",
        sha256: migration_contract_sha,
        from: "v4.16.2",
        to: "v4.17.1",
        total: 20,
        forward_compatible_services: ["rails", "sidekiq"],
        automatic_database_rollback: false
      },
      image: { ref: image_ref }.merge(digests),
      archives: { oci_sha256: oci_sha, docker_sha256: docker_sha },
      build_metadata_sha256: metadata_sha,
      attestations: {
        buildkit_provenance: {
          path: "chatwoot.buildkit-provenance.json",
          predicate_type: "https://slsa.dev/provenance/v0.2",
          sha256: provenance_sha
        },
        spdx_sbom: {
          path: "chatwoot.spdx.json",
          predicate_type: "https://spdx.dev/Document",
          sha256: sbom_sha
        }
      }
    }
    File.open(path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
      file.write(JSON.pretty_generate(release) + "\n")
    end
  ' "$release_json" "$PRODUCTION_IMAGE" "$RUN_ROOT/oci-digests.json" \
    "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" "$CONTROL_MANIFEST_SHA" \
    "$(sha256_file "$CONTROL_ROOT/tests/chatwoot-migrations-v4.16.2-to-v4.17.1.json")" \
    "$(sha256_file "$RUN_ROOT/chatwoot-release.oci.tar")" \
    "$(sha256_file "$RUN_ROOT/chatwoot-release.docker.tar")" \
    "$(sha256_file "$RUN_ROOT/build-metadata.json")" \
    "$(sha256_file "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json")" \
    "$(sha256_file "$RUN_ROOT/oci-attestations/chatwoot.spdx.json")"

  mkdir -m 0700 "$staging"
  cp -p "$RUN_ROOT/chatwoot-release.oci.tar" "$staging/chatwoot-release.oci.tar"
  cp -p "$RUN_ROOT/chatwoot-release.docker.tar" "$staging/chatwoot-release.docker.tar"
  cp -p "$RUN_ROOT/build-metadata.json" "$staging/build-metadata.json"
  cp -p "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json" \
    "$staging/chatwoot.buildkit-provenance.json"
  cp -p "$RUN_ROOT/oci-attestations/chatwoot.spdx.json" "$staging/chatwoot.spdx.json"
  cp -p "$release_json" "$staging/release.json"
  (
    cd "$staging"
    for file in build-metadata.json chatwoot-release.docker.tar chatwoot-release.oci.tar \
      chatwoot.buildkit-provenance.json chatwoot.spdx.json release.json; do
      printf '%s  %s\n' "$(sha256_file "$file")" "$file"
    done > release.sha256
  )
  ruby "$CONTROL_ROOT/tests/verify_chatwoot_release_artifact.rb" \
    "$staging" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA"
  attestation_verify_dir="$RUN_ROOT/release-attestations"
  mkdir -m 0700 "$attestation_verify_dir"
  ln "$staging/chatwoot.buildkit-provenance.json" \
    "$attestation_verify_dir/chatwoot.buildkit-provenance.json"
  ln "$staging/chatwoot.spdx.json" "$attestation_verify_dir/chatwoot.spdx.json"
  ruby "$CONTROL_ROOT/tests/verify_chatwoot_oci_archive.rb" \
    "$staging/chatwoot-release.oci.tar" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA" "$CONTROL_ROOT/tests/chatwoot-production-layers.json" \
    "$staging/release.json" "$attestation_verify_dir" verify

  # checksum名簿へpath traversal/追加fileを混ぜた成果物を必ず拒否する負例。
  negative="$RUN_ROOT/release-checksum-negative"
  mkdir -m 0700 "$negative"
  ln "$RUN_ROOT/build-metadata.json" "$negative/build-metadata.json"
  ln "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json" \
    "$negative/chatwoot.buildkit-provenance.json"
  ln "$RUN_ROOT/chatwoot-release.docker.tar" "$negative/chatwoot-release.docker.tar"
  ln "$RUN_ROOT/chatwoot-release.oci.tar" "$negative/chatwoot-release.oci.tar"
  ln "$RUN_ROOT/oci-attestations/chatwoot.spdx.json" "$negative/chatwoot.spdx.json"
  ln "$release_json" "$negative/release.json"
  cp -p "$staging/release.sha256" "$negative/release.sha256"
  printf '%064d  ../outside\n' 0 >> "$negative/release.sha256"
  if ruby "$CONTROL_ROOT/tests/verify_chatwoot_release_artifact.rb" \
    "$negative" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA" >/dev/null 2>&1; then
    fail 'path traversalを含むrelease checksum名簿をverifierが拒否しません'
  fi

  # hash名簿まで攻撃者が更新しても、SBOM内容の修正版package証拠を偽装できない負例。
  negative="$RUN_ROOT/release-sbom-negative"
  mkdir -m 0700 "$negative"
  ln "$RUN_ROOT/build-metadata.json" "$negative/build-metadata.json"
  ln "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json" \
    "$negative/chatwoot.buildkit-provenance.json"
  ln "$RUN_ROOT/chatwoot-release.docker.tar" "$negative/chatwoot-release.docker.tar"
  ln "$RUN_ROOT/chatwoot-release.oci.tar" "$negative/chatwoot-release.oci.tar"
  cp -p "$RUN_ROOT/oci-attestations/chatwoot.spdx.json" "$negative/chatwoot.spdx.json"
  ruby -rjson -e '
    path = ARGV.fetch(0)
    document = JSON.parse(File.binread(path))
    package = document.fetch("packages").find { |candidate| candidate["name"] == "musl-utils" }
    abort "musl-utils fixture missing" unless package
    package["versionInfo"] = "1.2.5-r9"
    File.binwrite(path, JSON.pretty_generate(document) + "\n")
  ' "$negative/chatwoot.spdx.json"
  cp -p "$release_json" "$negative/release.json"
  ruby -rjson -rdigest -e '
    release_path, sbom_path = ARGV
    release = JSON.parse(File.binread(release_path))
    release.fetch("attestations").fetch("spdx_sbom")["sha256"] = Digest::SHA256.file(sbom_path).hexdigest
    File.binwrite(release_path, JSON.pretty_generate(release) + "\n")
  ' "$negative/release.json" "$negative/chatwoot.spdx.json"
  (
    cd "$negative"
    for file in build-metadata.json chatwoot-release.docker.tar chatwoot-release.oci.tar \
      chatwoot.buildkit-provenance.json chatwoot.spdx.json release.json; do
      printf '%s  %s\n' "$(sha256_file "$file")" "$file"
    done > release.sha256
  )
  if ruby "$CONTROL_ROOT/tests/verify_chatwoot_release_artifact.rb" \
    "$negative" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA" >/dev/null 2>&1; then
    fail 'hashを再計算した脆弱SBOM fixtureをrelease verifierが拒否しません'
  fi

  negative="$RUN_ROOT/release-provenance-negative"
  mkdir -m 0700 "$negative"
  ln "$RUN_ROOT/build-metadata.json" "$negative/build-metadata.json"
  ln "$RUN_ROOT/chatwoot-release.docker.tar" "$negative/chatwoot-release.docker.tar"
  ln "$RUN_ROOT/chatwoot-release.oci.tar" "$negative/chatwoot-release.oci.tar"
  ln "$RUN_ROOT/oci-attestations/chatwoot.spdx.json" "$negative/chatwoot.spdx.json"
  cp -p "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json" \
    "$negative/chatwoot.buildkit-provenance.json"
  ruby -rjson -e '
    path = ARGV.fetch(0)
    statement = JSON.parse(File.binread(path))
    statement.fetch("predicate").fetch("invocation").fetch("parameters").fetch("args")[
      "build-arg:TOYBACO_CONTROL_SHA256"
    ] = "0" * 64
    File.binwrite(path, JSON.pretty_generate(statement) + "\n")
  ' "$negative/chatwoot.buildkit-provenance.json"
  cp -p "$release_json" "$negative/release.json"
  ruby -rjson -rdigest -e '
    release_path, provenance_path = ARGV
    release = JSON.parse(File.binread(release_path))
    release.fetch("attestations").fetch("buildkit_provenance")["sha256"] =
      Digest::SHA256.file(provenance_path).hexdigest
    File.binwrite(release_path, JSON.pretty_generate(release) + "\n")
  ' "$negative/release.json" "$negative/chatwoot.buildkit-provenance.json"
  (
    cd "$negative"
    for file in build-metadata.json chatwoot-release.docker.tar chatwoot-release.oci.tar \
      chatwoot.buildkit-provenance.json chatwoot.spdx.json release.json; do
      printf '%s  %s\n' "$(sha256_file "$file")" "$file"
    done > release.sha256
  )
  if ruby "$CONTROL_ROOT/tests/verify_chatwoot_release_artifact.rb" \
    "$negative" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA" >/dev/null 2>&1; then
    fail 'hashを再計算した偽provenance fixtureをrelease verifierが拒否しません'
  fi

  # Docker engineのcontainerd/classic差でconfig/indexを取り違えても、manifest digestを
  # 自称してpublisherへ渡せないことを、全hash再計算後の負例で固定する。
  negative="$RUN_ROOT/release-digest-negative"
  mkdir -m 0700 "$negative"
  ln "$RUN_ROOT/build-metadata.json" "$negative/build-metadata.json"
  ln "$RUN_ROOT/oci-attestations/chatwoot.buildkit-provenance.json" \
    "$negative/chatwoot.buildkit-provenance.json"
  ln "$RUN_ROOT/chatwoot-release.docker.tar" "$negative/chatwoot-release.docker.tar"
  ln "$RUN_ROOT/chatwoot-release.oci.tar" "$negative/chatwoot-release.oci.tar"
  ln "$RUN_ROOT/oci-attestations/chatwoot.spdx.json" "$negative/chatwoot.spdx.json"
  cp -p "$release_json" "$negative/release.json"
  ruby -rjson -e '
    path = ARGV.fetch(0)
    release = JSON.parse(File.binread(path))
    release.fetch("image")["manifest_digest"] = "sha256:" + ("0" * 64)
    File.binwrite(path, JSON.pretty_generate(release) + "\n")
  ' "$negative/release.json"
  (
    cd "$negative"
    for file in build-metadata.json chatwoot-release.docker.tar chatwoot-release.oci.tar \
      chatwoot.buildkit-provenance.json chatwoot.spdx.json release.json; do
      printf '%s  %s\n' "$(sha256_file "$file")" "$file"
    done > release.sha256
  )
  if ruby "$CONTROL_ROOT/tests/verify_chatwoot_release_artifact.rb" \
    "$negative" "$CHATWOOT_SOURCE_COMMIT" "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA" >/dev/null 2>&1; then
    fail 'hashを再計算した偽manifest digestをrelease verifierが拒否しません'
  fi
  mv "$staging" "$ARTIFACT_DIR"
}

assert_final_boundaries() {
  local current="$RUN_ROOT/current.fingerprint"
  local source_path

  STAGE='最終source/control境界'
  control_manifest "$ROOT" > "$RUN_ROOT/control.final"
  cmp "$CONTROL_MANIFEST" "$RUN_ROOT/control.final" || fail \
    'gate実行中にcontrol allowlistが変更されました。結果を破棄します'

  git_source_fingerprint "$CLEAN_SOURCE" > "$current"
  cmp "$CLEAN_SOURCE_FINGERPRINT" "$current" || fail \
    'gate実行中にclean Chatwoot sourceが変更されました'

  if [[ -n "$SOURCE" ]]; then
    source_path="$(cd "$SOURCE" && pwd -P)"
    git_source_fingerprint "$source_path" > "$RUN_ROOT/seed.final"
    cmp "$SEED_FINGERPRINT" "$RUN_ROOT/seed.final" || fail \
      '--source seedがgate実行中に変更されました'
  fi

  git_source_fingerprint "$PATCHED_SOURCE" > "$RUN_ROOT/patched.final"
  cmp "$RUN_ROOT/patched-source.fingerprint" "$RUN_ROOT/patched.final" || fail \
    'Docker/test工程がpatched sourceを変更しました'
}

cleanup() {
  local exit_code=$?

  set +e
  if [[ "$exit_code" -ne 0 ]]; then
    [[ -z "$RAILS_NAME" ]] || ! docker container inspect "$RAILS_NAME" >/dev/null 2>&1 || \
      docker logs "$RAILS_NAME" >&2
    [[ -z "$SIDEKIQ_NAME" ]] || ! docker container inspect "$SIDEKIQ_NAME" >/dev/null 2>&1 || \
      docker logs "$SIDEKIQ_NAME" >&2
    [[ -z "$POSTGRES_NAME" ]] || ! docker container inspect "$POSTGRES_NAME" >/dev/null 2>&1 || \
      docker logs "$POSTGRES_NAME" >&2
    [[ -z "$REDIS_NAME" ]] || ! docker container inspect "$REDIS_NAME" >/dev/null 2>&1 || \
      docker logs "$REDIS_NAME" >&2
  fi
  [[ -z "$RAILS_NAME" ]] || docker rm --force "$RAILS_NAME" >/dev/null 2>&1
  [[ -z "$SIDEKIQ_NAME" ]] || docker rm --force "$SIDEKIQ_NAME" >/dev/null 2>&1
  [[ -z "$POSTGRES_NAME" ]] || docker rm --force "$POSTGRES_NAME" >/dev/null 2>&1
  [[ -z "$REDIS_NAME" ]] || docker rm --force "$REDIS_NAME" >/dev/null 2>&1
  [[ -z "$NETWORK_NAME" ]] || docker network rm "$NETWORK_NAME" >/dev/null 2>&1
  [[ -z "$TEST_IMAGE" ]] || docker image rm "$TEST_IMAGE" >/dev/null 2>&1
  [[ -z "$PRODUCTION_IMAGE" ]] || docker image rm "$PRODUCTION_IMAGE" >/dev/null 2>&1
  if [[ -n "$RUN_ROOT" && -f "$RUN_ROOT/.toybaco-chatwoot-gate-run" ]]; then
    rm -rf -- "$RUN_ROOT"
  fi
  return "$exit_code"
}

main() {
  local artifact_name
  local artifact_parent
  local config_digest
  local index_digest
  local manifest_digest
  local suffix
  local temp_base

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --source)
        [[ "$#" -ge 2 ]] || fail '--sourceにはdirectoryが必要です'
        SOURCE="$2"
        shift 2
        ;;
      --quality-only)
        QUALITY_ONLY=1
        shift
        ;;
      --artifact-dir)
        fail '--artifact-dir release bundleはowner再baselineでpark済みです'
        ;;
      --control-sha-only)
        CONTROL_SHA_ONLY=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail "未知の引数です: $1"
        ;;
    esac
  done

  STAGE='host preflight'
  for command_name in awk bash chmod cmp cp find git grep head ln mkdir mv node ruby sed sort tar touch wc; do
    require_command "$command_name"
  done
  if [[ "$CONTROL_SHA_ONLY" -eq 1 ]]; then
    [[ -z "$SOURCE" && -z "$ARTIFACT_DIR" ]] || fail '--control-sha-onlyは他の引数と併用できません'
    control_only_file="$(mktemp "${TMPDIR:-/tmp}/toybaco-chatwoot-control.XXXXXX")"
    control_manifest "$ROOT" > "$control_only_file"
    printf 'TOYBACO_CHATWOOT_CONTROL_SHA256=%s\n' "$(sha256_file "$control_only_file")"
    rm -f -- "$control_only_file"
    return 0
  fi
  require_command docker
  docker info >/dev/null 2>&1 || fail 'Docker daemonを利用できません'
  # Docker Desktopが既に共有しているworkspace filesystem上、かつGit rootの外へ
  # 専用tmpを作る。repo自体やrepoの親をmountすることはなく、bindするのは
  # この中のexact control/resultsだけ。
  temp_base="$(cd "$ROOT/.." && pwd -P)"
  RUN_ROOT="$(mktemp -d "$temp_base/toybaco-chatwoot-gate.XXXXXX")"
  touch "$RUN_ROOT/.toybaco-chatwoot-gate-run"
  CONTROL_ROOT="$RUN_ROOT/control"
  CLEAN_SOURCE="$RUN_ROOT/chatwoot-clean"
  PATCHED_SOURCE="$RUN_ROOT/chatwoot-patched"
  TEST_CONTEXT="$RUN_ROOT/chatwoot-test-context"
  CONTROL_MANIFEST="$RUN_ROOT/control.sha256"
  suffix="$$-$RANDOM"
  NETWORK_NAME="toybaco-cw-gate-$suffix"
  POSTGRES_NAME="toybaco-cw-pg-$suffix"
  REDIS_NAME="toybaco-cw-redis-$suffix"
  TEST_IMAGE="toybaco/chatwoot-gate-test:$suffix"
  PRODUCTION_IMAGE="toybaco/chatwoot-gate-production:$suffix"
  POSTGRES_TEST_PASSWORD="toybaco-gate-$suffix"
  SYNC_TEST_PASSWORD="toybaco-sync-$suffix"
  RAILS_NAME="toybaco-cw-rails-$suffix"
  SIDEKIQ_NAME="toybaco-cw-sidekiq-$suffix"
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  STAGE='control snapshot'
  control_manifest "$ROOT" > "$RUN_ROOT/control.before"
  copy_control_snapshot
  control_manifest "$CONTROL_ROOT" > "$CONTROL_MANIFEST"
  cmp "$RUN_ROOT/control.before" "$CONTROL_MANIFEST" || fail \
    'control snapshotのcopy前後でSHA-256が変わりました'
  CONTROL_MANIFEST_SHA="$(sha256_file "$CONTROL_MANIFEST")"
  assert_control_contract
  verify_base_and_frame_contract

  acquire_source
  ruby "$CONTROL_ROOT/scripts/generate-chatwoot-active-ja-overrides.rb" verify \
    "$CLEAN_SOURCE" "$CONTROL_ROOT/overlay/app"
  ruby "$CONTROL_ROOT/tests/verify_chatwoot_migration_contract.rb" "$CLEAN_SOURCE" \
    "$CONTROL_ROOT/tests/chatwoot-migrations-v4.16.2-to-v4.17.1.json" \
    "$CONTROL_ROOT/infra/terraform/ecs.tf"
  git -c advice.detachedHead=false clone --quiet --no-hardlinks "$CLEAN_SOURCE" "$PATCHED_SOURCE"
  rm -f "$PATCHED_SOURCE/.git/objects/info/alternates"
  assert_clean_source "$PATCHED_SOURCE"
  assert_overlay_application
  ruby "$CONTROL_ROOT/tests/chatwoot_full_japanese_test.rb" \
    "$CLEAN_SOURCE" "$CONTROL_ROOT/overlay/app"

  build_test_image
  start_services
  create_test_databases
  run_ruby_quality
  build_and_smoke_production_image
  assert_final_boundaries

  STAGE='完了'
  printf 'TOYBACO_CHATWOOT_GATE=PASS mode=quality-only source=%s tree=%s control=%s\n' \
    "$CHATWOOT_SOURCE_COMMIT" \
    "$CHATWOOT_SOURCE_TREE" \
    "$CONTROL_MANIFEST_SHA"
}

main "$@"
